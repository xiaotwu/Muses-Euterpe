<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Muses.App</RootNamespace>
    <AssemblyName>Muses</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.1.0</Version>
    <Product>Muses</Product>
    <Authors>xiaotwu</Authors>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Muses.Core\Muses.Core.csproj" />
    <ProjectReference Include="..\Muses.Persistence\Muses.Persistence.csproj" />
    <ProjectReference Include="..\Muses.Infrastructure\Muses.Infrastructure.csproj" />
    <ProjectReference Include="..\Muses.Platform.Windows\Muses.Platform.Windows.csproj" />
    <ProjectReference Include="..\Muses.Platform.Linux\Muses.Platform.Linux.csproj" />
    <ProjectReference Include="..\Muses.WebHome.Helper\Muses.WebHome.Helper.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <OutputItemType>_WebHomeHelperTarget</OutputItemType>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Include="..\..\resources\yt-dlp" Link="yt-dlp" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\resources\yt-dlp')" />
    <None Include="..\..\resources\yt-dlp.exe" Link="yt-dlp.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\resources\yt-dlp.exe')" />
    <None Include="..\..\resources\mpv.exe" Link="mpv.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\resources\mpv.exe')" />
    <None Include="..\..\resources\d3dcompiler_43.dll" Link="d3dcompiler_43.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\resources\d3dcompiler_43.dll')" />
  </ItemGroup>
  <Target Name="KeepCoreWebView2References" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Reference.Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyWebHomeHelper" AfterTargets="Build" Condition="'@(_WebHomeHelperTarget)' != ''">
    <PropertyGroup>
      <_HelperOut>@(_WebHomeHelperTarget->'%(RootDir)%(Directory)')</_HelperOut>
    </PropertyGroup>
    <ItemGroup>
      <_HelperFiles Include="$(_HelperOut)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_HelperFiles)" DestinationFolder="$(TargetDir)Helpers\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
