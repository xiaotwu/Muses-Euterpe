<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             x:Class="Muses.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
    <FontFamily x:Key="MonteCarlo">avares://Muses/Assets/Fonts/MonteCarlo.ttf#MonteCarlo</FontFamily>
    <FontFamily x:Key="Inter">fonts:Inter#Inter, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>

    <FontFamily x:Key="MusesBodyFont">fonts:Inter#Inter, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MusesHeadingFont">Georgia, Liberation Serif, DejaVu Serif, serif</FontFamily>

    <!-- Shared G1 palette from Polyhymnia -->
    <Color x:Key="MusesPageDark">#211F1B</Color>
    <Color x:Key="MusesSurfaceDark">#302B23</Color>
    <Color x:Key="MusesTextPrimary">#F6F0E7</Color>
    <Color x:Key="MusesTextSecondary">#BBB4A7</Color>
    <Color x:Key="MusesTextMuted">#A59D90</Color>
    <Color x:Key="MusesYouTubeRed">#FF0000</Color>
    <Color x:Key="MusesHairline">#1AFFFFFF</Color>
    <Color x:Key="MusesScrim">#59000000</Color>
    <Color x:Key="MusesSurfaceChrome">#E6302B23</Color>
    <Color x:Key="MusesCapsule">#CC302B23</Color>
    <Color x:Key="MusesDrawer">#F2302B23</Color>
    <Color x:Key="MusesSurfaceOverlay1F">#1F302B23</Color>
    <Color x:Key="MusesSurfaceOverlay33">#33302B23</Color>
    <Color x:Key="MusesSurfaceOverlay40">#40302B23</Color>
    <Color x:Key="MusesPageOpaqueDark">#D9211F1B</Color>
    <Color x:Key="MusesWhiteOverlay0A">#0AFFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay0D">#0DFFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay14">#14FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay1A">#1AFFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay1E">#1EFFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay24">#24FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay26">#26FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay2A">#2AFFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay2E">#2EFFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay33">#33FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay38">#38FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay40">#40FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay47">#47FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay59">#59FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay61">#61FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay66">#66FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay73">#73FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay80">#80FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlay99">#99FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlayB3">#B3FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlayCC">#CCFFFFFF</Color>
    <Color x:Key="MusesWhiteOverlayD1">#D1FFFFFF</Color>
    <Color x:Key="MusesWhiteOverlayE6">#E6FFFFFF</Color>
    <Color x:Key="MusesAccentOverlay14">#14DFC28B</Color>
    <Color x:Key="MusesAccentOverlay1A">#1ADFC28B</Color>
    <Color x:Key="MusesAccentOverlay26">#26DFC28B</Color>
    <Color x:Key="MusesAccentOverlay33">#33DFC28B</Color>
    <Color x:Key="MusesAccentOverlay59">#59DFC28B</Color>
    <Color x:Key="MusesAccentOverlay85">#85DFC28B</Color>
    <Color x:Key="MusesAccentOverlay99">#99DFC28B</Color>
    <Color x:Key="MusesAccentOverlayD9">#D9DFC28B</Color>
    <Color x:Key="MusesAccentOverlayE6">#E6DFC28B</Color>
    <Color x:Key="MusesBlackOverlay33">#33000000</Color>
    <Color x:Key="MusesBlackOverlay40">#40000000</Color>
    <Color x:Key="MusesBlackOverlay4D">#4D000000</Color>
    <Color x:Key="MusesBlackOverlay55">#55000000</Color>
    <Color x:Key="MusesBlackOverlay59">#59000000</Color>
    <Color x:Key="MusesBlackOverlay60">#60000000</Color>
    <Color x:Key="MusesBlackOverlay66">#66000000</Color>
    <Color x:Key="MusesBlackOverlay73">#73000000</Color>
    <Color x:Key="MusesBlackOverlay80">#80000000</Color>
    <Color x:Key="MusesBlackOverlay99">#99000000</Color>
    <Color x:Key="MusesBlackOverlayB3">#B3000000</Color>
    <Color x:Key="MusesTextSecondaryMuted">#80BBB4A7</Color>
    <Color x:Key="MusesTextPrimaryMuted">#CCF6F0E7</Color>

    <!-- Brush tokens (prefer these in AXAML; Color keys remain for Color-typed APIs) -->
    <SolidColorBrush x:Key="MusesYouTubeRedBrush" Color="{StaticResource MusesYouTubeRed}" />
    <SolidColorBrush x:Key="MusesScrimBrush" Color="{StaticResource MusesScrim}" />
    <SolidColorBrush x:Key="MusesSurfaceOverlay1FBrush" Color="{StaticResource MusesSurfaceOverlay1F}" />
    <SolidColorBrush x:Key="MusesSurfaceOverlay33Brush" Color="{StaticResource MusesSurfaceOverlay33}" />
    <SolidColorBrush x:Key="MusesSurfaceOverlay40Brush" Color="{StaticResource MusesSurfaceOverlay40}" />
    <SolidColorBrush x:Key="MusesTextSecondaryMutedBrush" Color="{StaticResource MusesTextSecondaryMuted}" />
    <SolidColorBrush x:Key="MusesTextPrimaryMutedBrush" Color="{StaticResource MusesTextPrimaryMuted}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay0ABrush" Color="{StaticResource MusesWhiteOverlay0A}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay0DBrush" Color="{StaticResource MusesWhiteOverlay0D}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay1EBrush" Color="{StaticResource MusesWhiteOverlay1E}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay24Brush" Color="{StaticResource MusesWhiteOverlay24}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay26Brush" Color="{StaticResource MusesWhiteOverlay26}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay2ABrush" Color="{StaticResource MusesWhiteOverlay2A}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay2EBrush" Color="{StaticResource MusesWhiteOverlay2E}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay38Brush" Color="{StaticResource MusesWhiteOverlay38}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay40Brush" Color="{StaticResource MusesWhiteOverlay40}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay47Brush" Color="{StaticResource MusesWhiteOverlay47}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay59Brush" Color="{StaticResource MusesWhiteOverlay59}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay61Brush" Color="{StaticResource MusesWhiteOverlay61}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay66Brush" Color="{StaticResource MusesWhiteOverlay66}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay73Brush" Color="{StaticResource MusesWhiteOverlay73}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay80Brush" Color="{StaticResource MusesWhiteOverlay80}" />
    <SolidColorBrush x:Key="MusesWhiteOverlay99Brush" Color="{StaticResource MusesWhiteOverlay99}" />
    <SolidColorBrush x:Key="MusesWhiteOverlayB3Brush" Color="{StaticResource MusesWhiteOverlayB3}" />
    <SolidColorBrush x:Key="MusesWhiteOverlayCCBrush" Color="{StaticResource MusesWhiteOverlayCC}" />
    <SolidColorBrush x:Key="MusesWhiteOverlayD1Brush" Color="{StaticResource MusesWhiteOverlayD1}" />
    <SolidColorBrush x:Key="MusesWhiteOverlayE6Brush" Color="{StaticResource MusesWhiteOverlayE6}" />
    <SolidColorBrush x:Key="MusesAccentOverlay14Brush" Color="{StaticResource MusesAccentOverlay14}" />
    <SolidColorBrush x:Key="MusesAccentOverlay1ABrush" Color="{StaticResource MusesAccentOverlay1A}" />
    <SolidColorBrush x:Key="MusesAccentOverlay26Brush" Color="{StaticResource MusesAccentOverlay26}" />
    <SolidColorBrush x:Key="MusesAccentOverlay33Brush" Color="{StaticResource MusesAccentOverlay33}" />
    <SolidColorBrush x:Key="MusesAccentOverlay59Brush" Color="{StaticResource MusesAccentOverlay59}" />
    <SolidColorBrush x:Key="MusesAccentOverlay85Brush" Color="{StaticResource MusesAccentOverlay85}" />
    <SolidColorBrush x:Key="MusesAccentOverlay99Brush" Color="{StaticResource MusesAccentOverlay99}" />
    <SolidColorBrush x:Key="MusesAccentOverlayD9Brush" Color="{StaticResource MusesAccentOverlayD9}" />
    <SolidColorBrush x:Key="MusesAccentOverlayE6Brush" Color="{StaticResource MusesAccentOverlayE6}" />
    <SolidColorBrush x:Key="MusesBlackOverlay33Brush" Color="{StaticResource MusesBlackOverlay33}" />
    <SolidColorBrush x:Key="MusesBlackOverlay40Brush" Color="{StaticResource MusesBlackOverlay40}" />
    <SolidColorBrush x:Key="MusesBlackOverlay4DBrush" Color="{StaticResource MusesBlackOverlay4D}" />
    <SolidColorBrush x:Key="MusesBlackOverlay55Brush" Color="{StaticResource MusesBlackOverlay55}" />
    <SolidColorBrush x:Key="MusesBlackOverlay59Brush" Color="{StaticResource MusesBlackOverlay59}" />
    <SolidColorBrush x:Key="MusesBlackOverlay60Brush" Color="{StaticResource MusesBlackOverlay60}" />
    <SolidColorBrush x:Key="MusesBlackOverlay66Brush" Color="{StaticResource MusesBlackOverlay66}" />
    <SolidColorBrush x:Key="MusesBlackOverlay73Brush" Color="{StaticResource MusesBlackOverlay73}" />
    <SolidColorBrush x:Key="MusesBlackOverlay80Brush" Color="{StaticResource MusesBlackOverlay80}" />
    <SolidColorBrush x:Key="MusesBlackOverlay99Brush" Color="{StaticResource MusesBlackOverlay99}" />
    <SolidColorBrush x:Key="MusesBlackOverlayB3Brush" Color="{StaticResource MusesBlackOverlayB3}" />

    <!-- Motion durations (seconds from Muses.Core.Chrome.MusesMotion → Avalonia TimeSpan).
         MotionChrome.Apply syncs these from constants at startup and zeros them when OS reduce-motion is on. -->
    <sys:TimeSpan x:Key="MusesMotionHover">0:0:0.15</sys:TimeSpan>
    <sys:TimeSpan x:Key="MusesMotionOverlay">0:0:0.20</sys:TimeSpan>
    <sys:TimeSpan x:Key="MusesMotionDrawer">0:0:0.25</sys:TimeSpan>
    <sys:TimeSpan x:Key="MusesMotionNowPlayingMorph">0:0:0.32</sys:TimeSpan>
    <sys:TimeSpan x:Key="MusesMotionCollectionDeckSnap">0:0:0.22</sys:TimeSpan>
    <sys:TimeSpan x:Key="MusesMotionCollectionListTransition">0:0:0.29</sys:TimeSpan>
    <sys:TimeSpan x:Key="MusesMotionCollectionCardActivation">0:0:0.30</sys:TimeSpan>

    <!-- In-window surface roles shared by both desktop hosts -->
    <BoxShadows x:Key="MusesGlassDockShadow">0 3 12 0 #40000000</BoxShadows>
    <BoxShadows x:Key="MusesGlassPlaybackShadow">0 5 18 0 #33000000</BoxShadows>
    <sys:Double x:Key="MusesGlassAtmosphereOpacity">1</sys:Double>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="MusesPageColor">#211F1B</Color>
          <Color x:Key="MusesAccent">#DFC28B</Color>
          <SolidColorBrush x:Key="MusesAccentBrush" Color="#DFC28B" />
          <SolidColorBrush x:Key="MusesHeadingBrush" Color="#F5E3BF" />
          <SolidColorBrush x:Key="MusesSelectionBrush" Color="#4F4635" />
          <SolidColorBrush x:Key="MusesPlaybackBrush" Color="#C7CDD4" />
          <SolidColorBrush x:Key="MusesOnPlaybackBrush" Color="#182029" />
          <SolidColorBrush x:Key="MusesPageBrush" Color="#211F1B" />
          <SolidColorBrush x:Key="MusesSurfaceBrush" Color="#302B23" />
          <SolidColorBrush x:Key="MusesTextPrimaryBrush" Color="#F6F0E7" />
          <SolidColorBrush x:Key="MusesTextSecondaryBrush" Color="#BBB4A7" />
          <SolidColorBrush x:Key="MusesTextMutedBrush" Color="#A59D90" />
          <SolidColorBrush x:Key="MusesHairlineBrush" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="MusesCapsuleBrush" Color="#CC302B23" />
          <SolidColorBrush x:Key="MusesDrawerBrush" Color="#F2302B23" />
          <SolidColorBrush x:Key="MusesSurfaceChromeBrush" Color="#E6302B23" />
          <SolidColorBrush x:Key="MusesGlassSidebarBrush" Color="#ED2C2821" />
          <LinearGradientBrush x:Key="MusesGlassPanelBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#FA413A30" />
            <GradientStop Offset="0.44" Color="#F3302B23" />
            <GradientStop Offset="1" Color="#F229251F" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="MusesGlassCapsuleBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#ED443D32" />
            <GradientStop Offset="0.26" Color="#E6332E26" />
            <GradientStop Offset="0.82" Color="#E62D2922" />
            <GradientStop Offset="1" Color="#EC373127" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="MusesGlassClearBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#DC433C32" />
            <GradientStop Offset="0.32" Color="#CD302B23" />
            <GradientStop Offset="0.84" Color="#C92A261F" />
            <GradientStop Offset="1" Color="#D83A3328" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="MusesGlassRimBrush" StartPoint="0%,0%" EndPoint="80%,100%">
            <GradientStop Offset="0" Color="#73F6F0E7" />
            <GradientStop Offset="0.28" Color="#29F6F0E7" />
            <GradientStop Offset="0.73" Color="#16F6F0E7" />
            <GradientStop Offset="1" Color="#50F6F0E7" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="MusesGlassDrawerBrush" Color="#F2302B23" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="MusesPageColor">#FCFAF6</Color>
          <Color x:Key="MusesAccent">#86632E</Color>
          <SolidColorBrush x:Key="MusesAccentBrush" Color="#86632E" />
          <SolidColorBrush x:Key="MusesHeadingBrush" Color="#6D522C" />
          <SolidColorBrush x:Key="MusesSelectionBrush" Color="#EEE4D1" />
          <SolidColorBrush x:Key="MusesPlaybackBrush" Color="#44505C" />
          <SolidColorBrush x:Key="MusesOnPlaybackBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MusesPageBrush" Color="#FCFAF6" />
          <SolidColorBrush x:Key="MusesSurfaceBrush" Color="#F0ECE4" />
          <SolidColorBrush x:Key="MusesTextPrimaryBrush" Color="#26221D" />
          <SolidColorBrush x:Key="MusesTextSecondaryBrush" Color="#625A4F" />
          <SolidColorBrush x:Key="MusesTextMutedBrush" Color="#706559" />
          <SolidColorBrush x:Key="MusesHairlineBrush" Color="#1A000000" />
          <SolidColorBrush x:Key="MusesCapsuleBrush" Color="#F2F0ECE4" />
          <SolidColorBrush x:Key="MusesDrawerBrush" Color="#FFF0ECE4" />
          <SolidColorBrush x:Key="MusesSurfaceChromeBrush" Color="#F2F0ECE4" />
          <SolidColorBrush x:Key="MusesGlassSidebarBrush" Color="#EDF2EEE6" />
          <LinearGradientBrush x:Key="MusesGlassPanelBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#FDFFFEFA" />
            <GradientStop Offset="0.44" Color="#F6F6F2EB" />
            <GradientStop Offset="1" Color="#F2EAE3D7" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="MusesGlassCapsuleBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#FBFFFEFA" />
            <GradientStop Offset="0.26" Color="#F0F5F1E9" />
            <GradientStop Offset="0.82" Color="#EDEEE8DE" />
            <GradientStop Offset="1" Color="#F3F6F2E9" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="MusesGlassClearBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#F0FFFEFA" />
            <GradientStop Offset="0.32" Color="#DFF7F3EB" />
            <GradientStop Offset="0.84" Color="#DBEEE8DD" />
            <GradientStop Offset="1" Color="#ECFFFCF4" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="MusesGlassRimBrush" StartPoint="0%,0%" EndPoint="80%,100%">
            <GradientStop Offset="0" Color="#E6FFFFFF" />
            <GradientStop Offset="0.28" Color="#2472614D" />
            <GradientStop Offset="0.73" Color="#3872614D" />
            <GradientStop Offset="1" Color="#D1FFFFFF" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="MusesGlassDrawerBrush" Color="#FFF0ECE4" />
          <SolidColorBrush x:Key="MusesWhiteOverlay14Brush" Color="#14000000" />
          <SolidColorBrush x:Key="MusesWhiteOverlay1ABrush" Color="#1A000000" />
          <SolidColorBrush x:Key="MusesWhiteOverlay33Brush" Color="#33000000" />
          <SolidColorBrush x:Key="MusesPageOpaqueDarkBrush" Color="#D9FCFAF6" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#DFC28B" />
        <ColorPaletteResources x:Key="Light" Accent="#86632E" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- Default UI typeface: Inter (MonteCarlo reserved for Muses wordmark) -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource MusesBodyFont}" />
    </Style>
  </Application.Styles>
</Application>
