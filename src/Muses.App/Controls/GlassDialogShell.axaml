<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Muses.App.Controls.GlassDialogShell"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
  <Border x:Name="ShellBorder"
          Background="{DynamicResource MusesGlassPanelBrush}"
          BorderBrush="{DynamicResource MusesHairlineBrush}"
          BorderThickness="1"
          CornerRadius="16"
          Padding="24">
    <DockPanel>
      <TextBlock x:Name="TitleBlock"
                 DockPanel.Dock="Top"
                 FontSize="20"
                 FontFamily="{StaticResource MusesHeadingFont}"
                 Foreground="{DynamicResource MusesHeadingBrush}"
                 Margin="0,0,0,14"
                 IsVisible="False"
                 TextWrapping="Wrap" />
      <ContentControl x:Name="BodyHost" />
    </DockPanel>
  </Border>
</UserControl>
