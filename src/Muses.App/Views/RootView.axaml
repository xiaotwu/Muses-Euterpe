<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Muses.App.ViewModels"
             xmlns:views="using:Muses.App.Views"
             xmlns:ctrl="using:Muses.App.Controls"
             xmlns:playback="using:Muses.App.Controls.Playback"
             x:Class="Muses.App.Views.RootView"
             x:DataType="vm:ShellViewModel">
  <Panel Background="{DynamicResource MusesPageBrush}">
    <Grid x:Name="BrowseLayer" ColumnDefinitions="88,*,Auto">
      <Grid Grid.Column="1" RowDefinitions="*,Auto">
        <Panel IsVisible="{Binding !SettingsOpen}">
          <views:HomeView IsVisible="{Binding IsHome}" />
          <views:SearchView IsVisible="{Binding IsSearch}" />
          <views:NewView x:Name="NewPage" IsVisible="{Binding IsDiscover}" />
          <views:RecentlyView IsVisible="{Binding IsRecently}" />
          <views:SongsView x:Name="SongsPage" IsVisible="{Binding IsSongs}" />
          <views:CatalogReleasesView IsVisible="{Binding IsAlbumsOverview}" />
          <views:CatalogReleaseDetailView IsVisible="{Binding IsReleaseDetail}" />
          <views:CatalogArtistsView IsVisible="{Binding IsArtistsOverview}" />
          <views:CatalogArtistDetailView IsVisible="{Binding IsArtistDetail}" />
          <views:HistoryView IsVisible="{Binding IsHistory}" />
          <views:PlaylistsOverviewView IsVisible="{Binding IsPlaylistsOverview}" />
          <views:PlaylistDetailView IsVisible="{Binding IsPlaylistsDetailVisible}" />
          <views:InboxView IsVisible="{Binding IsInbox}" />
          <Panel IsVisible="{Binding IsPodcasts}">
            <views:PodcastsView DataContext="{Binding Podcasts}" />
          </Panel>
        </Panel>
        <DockPanel IsVisible="{Binding SettingsOpen}" Margin="24,24,24,20" MaxWidth="760">
          <TextBlock DockPanel.Dock="Top" Text="{Binding SettingsLabel}"
                     Margin="0,0,0,20" FontSize="32"
                     FontFamily="{StaticResource MusesHeadingFont}"
                     Foreground="{DynamicResource MusesAccentBrush}" />
          <views:SettingsView />
        </DockPanel>

        <views:PlayerBarView x:Name="PlayerDock" Grid.Row="1"
                             HorizontalAlignment="Stretch"
                             Margin="16,0,16,20" />
      </Grid>

      <!-- Integrated Trailing Drawers: Lyrics & Queue -->
      <Panel Grid.Column="2" IsVisible="{Binding !SettingsOpen}">
        <views:LyricsDrawerView VerticalAlignment="Stretch"
                                IsVisible="{Binding IsLyricsDrawerOpen}" />
        <views:QueueDrawerView VerticalAlignment="Stretch"
                               IsVisible="{Binding IsQueueDrawerOpen}" />
      </Panel>
      <views:SidebarView Grid.ColumnSpan="2" Width="234" HorizontalAlignment="Left" ZIndex="10" />
    </Grid>

    <!-- Full-Window Now Playing Overlay -->
    <views:NowPlayingView x:Name="NowPlaying" IsVisible="False" ZIndex="25" />
    <playback:CoverArtworkMorph x:Name="CoverMorph" IsVisible="False"
                               IsHitTestVisible="False" ZIndex="25" />

    <!-- YouTube Video Stage Overlay -->
    <views:YouTubeVideoOverlay IsVisible="{Binding IsVideoOverlayOpen}"
                               ZIndex="30" />

    <Panel IsVisible="{Binding PasteOpen}" ZIndex="21">
      <Border Background="{StaticResource MusesScrimBrush}" PointerPressed="OnPasteScrimPressed" />
      <ctrl:GlassDialogShell Width="480" Title="{Binding PasteTitle}" TitleFontSize="22">
        <ctrl:GlassDialogShell.DialogContent>
          <StackPanel Spacing="14">
            <TextBox Text="{Binding PasteUrl}" PlaceholderText="https://www.youtube.com/watch?v=…" />
            <TextBlock Text="{Binding PasteError}" Foreground="{DynamicResource MusesAccentBrush}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MusesTextSecondaryBrush}" FontSize="12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="{Binding CancelLabel}" Command="{Binding ClosePasteCommand}" />
              <Button Content="{Binding ImportLabel}"
                      Background="{DynamicResource MusesAccentBrush}" Foreground="White" BorderThickness="0"
                      Command="{Binding ImportPasteCommand}"
                      IsEnabled="{Binding !PasteBusy}" />
            </StackPanel>
          </StackPanel>
        </ctrl:GlassDialogShell.DialogContent>
      </ctrl:GlassDialogShell>
    </Panel>

    <!-- Modal 1: Playlist Add Choice Sheet -->
    <Panel IsVisible="{Binding ShowAddChoiceSheet}" ZIndex="22">
      <Border Background="{StaticResource MusesScrimBrush}" PointerPressed="OnAddChoiceScrimPressed" />
      <Border Width="420"
              CornerRadius="18"
              Background="{DynamicResource MusesGlassPanelBrush}"
              BorderBrush="{DynamicResource MusesHairlineBrush}"
              BorderThickness="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="24">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding AddPlaylistLabel}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
            <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MusesTextSecondaryBrush}"
                    Command="{Binding CloseAddChoiceCommand}" Cursor="Hand" />
          </Grid>
          <!-- Choice 1: New Playlist -->
          <Button Background="{DynamicResource MusesSurfaceBrush}" BorderBrush="{DynamicResource MusesHairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="14"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Command="{Binding OpenNewPlaylistDialogCommand}" Cursor="Hand">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="20" Height="20" Foreground="{DynamicResource MusesAccentBrush}" Margin="0,0,14,0" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{Binding NewPlaylistLabel}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
                <TextBlock Text="{Binding NewPlaylistDescLabel}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
              </StackPanel>
              <PathIcon Grid.Column="2" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Width="12" Height="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
            </Grid>
          </Button>
          <!-- Choice 2: Import YouTube Playlist -->
          <Button Background="{DynamicResource MusesSurfaceBrush}" BorderBrush="{DynamicResource MusesHairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="14"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Command="{Binding OpenImportDialogCommand}" Cursor="Hand">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="M14,2L20,8V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V4A2,2 0 0,1 6,2H14M18,20V9H13V4H6V20H18M12,12L16,16H13.5V19H10.5V16H8L12,12Z" Width="20" Height="20" Foreground="{DynamicResource MusesAccentBrush}" Margin="0,0,14,0" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{Binding ImportYouTubeLabel}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
                <TextBlock Text="{Binding ImportYouTubeDescLabel}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
              </StackPanel>
              <PathIcon Grid.Column="2" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Width="12" Height="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>
    </Panel>

    <!-- Modal 2: New Playlist Dialog -->
    <Panel IsVisible="{Binding ShowNewPlaylistDialog}" ZIndex="23">
      <Border Background="{StaticResource MusesScrimBrush}" PointerPressed="OnNewPlaylistScrimPressed" />
      <ctrl:GlassDialogShell Width="360" Title="{Binding NewPlaylistLabel}">
        <ctrl:GlassDialogShell.DialogContent>
          <StackPanel Spacing="16">
            <TextBox Text="{Binding NewPlaylistName}" PlaceholderText="{Binding PlaylistNameWatermark}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="{Binding CancelLabel}" Command="{Binding CloseNewPlaylistDialogCommand}" />
              <Button Content="{Binding CreateLabel}"
                      Background="{DynamicResource MusesAccentBrush}" Foreground="White" BorderThickness="0"
                      Command="{Binding CreatePlaylistCommand}" />
            </StackPanel>
          </StackPanel>
        </ctrl:GlassDialogShell.DialogContent>
      </ctrl:GlassDialogShell>
    </Panel>

    <!-- Modal 3: Import YouTube Playlist Dialog -->
    <Panel IsVisible="{Binding ShowImportDialog}" ZIndex="24">
      <Border Background="{StaticResource MusesScrimBrush}" PointerPressed="OnImportScrimPressed" />
      <ctrl:GlassDialogShell Width="480" Title="{Binding ImportYouTubeLabel}">
        <ctrl:GlassDialogShell.DialogContent>
          <StackPanel Spacing="14">
            <TextBox Text="{Binding ImportPlaylistUrl}" PlaceholderText="https://www.youtube.com/playlist?list=PL..." />
            <TextBlock Text="{Binding ImportNoticeLabel}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ImportError}" Foreground="{DynamicResource MusesAccentBrush}" IsVisible="{Binding ImportError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="{Binding CancelLabel}" Command="{Binding CloseImportDialogCommand}" />
              <Button Content="{Binding ImportActionLabel}"
                      Background="{DynamicResource MusesAccentBrush}" Foreground="White" BorderThickness="0"
                      Command="{Binding ImportPlaylistCommand}"
                      IsEnabled="{Binding !ImportBusy}" />
            </StackPanel>
          </StackPanel>
        </ctrl:GlassDialogShell.DialogContent>
      </ctrl:GlassDialogShell>
    </Panel>

    <!-- Modal: 32-band Graphic Equalizer -->
    <Panel IsVisible="{Binding IsEQOpen}" ZIndex="25">
      <Border Background="{StaticResource MusesScrimBrush}" PointerPressed="OnEQScrimPressed" />
      <views:EQView HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>

    <!-- Modal: Save Custom EQ Preset Dialog -->
    <Panel IsVisible="{Binding IsSaveEQPresetOpen}" ZIndex="26">
      <Border Background="{StaticResource MusesScrimBrush}" PointerPressed="OnSaveEQPresetScrimPressed" />
      <ctrl:GlassDialogShell Width="360" Title="Save EQ Preset">
        <ctrl:GlassDialogShell.DialogContent>
          <StackPanel Spacing="16">
            <TextBox Text="{Binding NewEQPresetName, Mode=TwoWay}" PlaceholderText="Preset name..." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="{Binding CancelLabel}" Command="{Binding CloseSaveEQPresetCommand}" />
              <Button Content="Save"
                      Background="{DynamicResource MusesAccentBrush}" Foreground="White" BorderThickness="0"
                      Command="{Binding SaveEQPresetCommand}" />
            </StackPanel>
          </StackPanel>
        </ctrl:GlassDialogShell.DialogContent>
      </ctrl:GlassDialogShell>
    </Panel>

    <!-- Modal: Audio Nerd Stream Info Panel -->
    <Panel IsVisible="{Binding IsAudioNerdOpen}" ZIndex="25">
      <Border Background="{StaticResource MusesScrimBrush}" PointerPressed="OnAudioNerdScrimPressed" />
      <views:AudioNerdPanel HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>

    <!-- Modal: Focus Mode Controller -->
    <Panel IsVisible="{Binding IsFocusOpen}" ZIndex="25">
      <Border Background="{StaticResource MusesScrimBrush}" PointerPressed="OnFocusScrimPressed" />
      <views:FocusView HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>

    <!-- Modal: Track Notes & Bookmarks Sheet -->
    <Panel IsVisible="{Binding IsNotesOpen}" ZIndex="25">
      <Border Background="{StaticResource MusesScrimBrush}" PointerPressed="OnNotesScrimPressed" />
      <views:NotesSheet HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>
  </Panel>
</UserControl>
