<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Muses.App.ViewModels"
             x:Class="Muses.App.Views.InboxView"
             x:DataType="vm:ShellViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,32,40,168" Spacing="28" MaxWidth="900" HorizontalAlignment="Left">
      <!-- Header -->
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding InboxTitle}" FontSize="34" FontWeight="Heavy" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <TextBlock Text="{Binding InboxSubtitle}"
                   FontSize="13" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
      </StackPanel>

      <!-- Empty State -->
      <Border Background="{DynamicResource MusesSurfaceBrush}" CornerRadius="12" Padding="24"
              IsVisible="{Binding IsInboxEmpty}">
        <TextBlock Text="{Binding InboxEmptyBody}"
                   FontSize="14" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
      </Border>

      <!-- Pending Section -->
      <StackPanel Spacing="12" IsVisible="{Binding HasPendingInboxItems}">
        <TextBlock Text="{Binding PendingLabel}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <ItemsControl ItemsSource="{Binding PendingInboxItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource MusesSurfaceBrush}" CornerRadius="10" Padding="14" Margin="0,3">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <!-- State icon -->
                  <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource MusesWhiteOverlay14Brush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="📥" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>

                  <!-- Track details -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding TrackTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
                    <TextBlock Text="{Binding Artist}" FontSize="13" Foreground="{StaticResource MusesTextSecondaryBrush}" />
                    <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="{StaticResource MusesAccentBrush}"
                               IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>

                  <!-- Action Buttons -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Play -->
                    <Button Content="▶" Classes="chromeBtn"
                            Background="{StaticResource MusesWhiteOverlay14Brush}" Foreground="{StaticResource MusesAccentBrush}"
                            Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).PlayInboxItemCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Play" />
                    <!-- Accept / Like -->
                    <Button Content="✓" Classes="chromeBtn"
                            Background="{StaticResource MusesWhiteOverlay14Brush}" Foreground="#30D158"
                            Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).AcceptInboxItemCommand}"
                            CommandParameter="{Binding Id}"
                            ToolTip.Tip="Accept (Like)" />
                    <!-- Reject -->
                    <Button Content="✕" Classes="chromeBtn"
                            Background="{StaticResource MusesWhiteOverlay14Brush}" Foreground="{StaticResource MusesTextSecondaryBrush}"
                            Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).RejectInboxItemCommand}"
                            CommandParameter="{Binding Id}"
                            ToolTip.Tip="Reject" />
                    <!-- Snooze (Tomorrow) -->
                    <Button Content="🌙 Tomorrow"
                            Background="{StaticResource MusesSurfaceBrush}" Foreground="{StaticResource MusesTextSecondaryBrush}" BorderBrush="{StaticResource MusesHairlineBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,4" FontSize="11"
                            Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).SnoozeInboxItemTomorrowCommand}"
                            CommandParameter="{Binding Id}"
                            ToolTip.Tip="Snooze until tomorrow" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Snoozed Section -->
      <StackPanel Spacing="12" IsVisible="{Binding HasSnoozedInboxItems}">
        <TextBlock Text="{Binding SnoozedLabel}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <ItemsControl ItemsSource="{Binding SnoozedInboxItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource MusesSurfaceBrush}" CornerRadius="10" Padding="14" Margin="0,3">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="🌙" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding TrackTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MusesTextSecondaryBrush}" />
                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{StaticResource MusesWhiteOverlay73Brush}" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="Restore"
                          Background="{StaticResource MusesWhiteOverlay14Brush}" Foreground="{StaticResource MusesAccentBrush}"
                          CornerRadius="6" Padding="8,4" FontSize="11"
                          Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).RestoreInboxItemCommand}"
                          CommandParameter="{Binding Id}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Decided Summary -->
      <Border Background="{StaticResource MusesWhiteOverlay14Brush}" CornerRadius="8" Padding="12"
              IsVisible="{Binding HasDecidedInboxItems}">
        <TextBlock Text="{Binding DecidedInboxSummary}" FontSize="13" Foreground="{StaticResource MusesTextSecondaryBrush}" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
