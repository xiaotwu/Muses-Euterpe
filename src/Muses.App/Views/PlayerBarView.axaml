<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Muses.App.ViewModels"
             xmlns:ctrl="using:Muses.App.Controls"
             x:Class="Muses.App.Views.PlayerBarView"
             x:DataType="vm:ShellViewModel"
             MaxWidth="668" Height="56"
             HorizontalAlignment="Center">
  <UserControl.Styles>
    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chrome PathIcon">
      <Setter Property="Foreground" Value="{StaticResource MusesTextMutedBrush}" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="{StaticResource MusesMotionHover}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.chrome:pointerover PathIcon">
      <Setter Property="Foreground" Value="{StaticResource MusesTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.chrome.active PathIcon">
      <Setter Property="Foreground" Value="{StaticResource MusesAccentBrush}" />
    </Style>
    <Style Selector="Button.chrome:disabled">
      <Setter Property="Opacity" Value="0.28" />
    </Style>

    <!-- Play/Pause 32x32 White Circle -->
    <Style Selector="Button.playBtn">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{StaticResource MusesTextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MusesMotionHover}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.playBtn:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
  </UserControl.Styles>

  <Border MaxWidth="668" Height="56"
          CornerRadius="1000"
          Background="{DynamicResource MusesGlassCapsuleBrush}"
          BorderBrush="{StaticResource MusesWhiteOverlay14Brush}"
          BorderThickness="1"
          BoxShadow="0 8 18 0 #59000000"
          Padding="14,0"
          HorizontalAlignment="Stretch"
          ClipToBounds="False">
    <Panel>
      <!-- Top Edge Progress Track (Insets 28px each side matching capsule corner curve) -->
      <Border x:Name="ProgressTrackContainer"
              Height="12"
              VerticalAlignment="Top"
              Margin="28,0,28,0"
              Background="Transparent"
              Cursor="Hand"
              ClipToBounds="False"
              PointerEntered="OnProgressPointerEntered"
              PointerExited="OnProgressPointerExited"
              PointerPressed="OnProgressPointerPressed"
              PointerMoved="OnProgressPointerMoved"
              PointerReleased="OnProgressPointerReleased"
              PointerCaptureLost="OnProgressPointerCaptureLost">
        <Panel VerticalAlignment="Top">
          <!-- Background Track -->
          <Border x:Name="ProgressTrackBg"
                  Height="3"
                  CornerRadius="1.5"
                  Background="{StaticResource MusesWhiteOverlay2EBrush}"
                  HorizontalAlignment="Stretch" />

          <!-- Filled Track (Magenta) -->
          <Border x:Name="ProgressTrackFill"
                  Height="3"
                  CornerRadius="1.5"
                  Background="{StaticResource MusesAccentBrush}"
                  HorizontalAlignment="Left"
                  Width="0" />

          <!-- Scrubber Thumb (White Circle) -->
          <Border x:Name="ProgressThumb"
                  Width="8" Height="8"
                  CornerRadius="4"
                  Background="White"
                  BoxShadow="0 1 3 0 #60000000"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="0,-2.5,0,0"
                  IsVisible="False" />
        </Panel>
      </Border>

      <!-- Main Controls Row -->
      <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
        <!-- 1. Leading Transport Cluster -->
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <!-- Shuffle -->
          <Button Classes="chrome" Classes.active="{Binding ShuffleOn}"
                  ToolTip.Tip="Shuffle" AutomationProperties.Name="Shuffle" Command="{Binding ToggleShuffleCommand}">
            <PathIcon Data="M14.83,13.41L13.42,14.82L16.55,17.95L14.5,20H20V14.5L17.96,16.54L14.83,13.41M14.5,4L16.54,6.04L4,18.59L5.41,20L17.96,7.46L20,9.5V4M10.59,9.17L5.41,4L4,5.41L9.17,10.58L10.59,9.17Z" />
          </Button>

          <!-- Previous -->
          <Button Classes="chrome" ToolTip.Tip="Previous" AutomationProperties.Name="Previous Track" Command="{Binding PreviousCommand}">
            <PathIcon Data="M6,18V6H8V18H6M9.5,12L18,6V18L9.5,12Z" />
          </Button>

          <!-- Play / Pause (Solid White Circle) -->
          <Button Classes="playBtn"
                  ToolTip.Tip="{Binding PlayLabel}"
                  AutomationProperties.Name="{Binding PlayLabel}"
                  Command="{Binding TogglePlaybackCommand}">
            <Panel>
              <!-- Progress Ring when playing -->
              <Ellipse Width="34" Height="34"
                       Stroke="{StaticResource MusesAccentBrush}" StrokeThickness="1.5"
                       IsVisible="{Binding IsPlaying}" />
              <!-- Play Icon -->
              <PathIcon Width="13" Height="13" Foreground="{StaticResource MusesPageBrush}" IsVisible="{Binding !IsPlaying}"
                        Data="M8,5.14V19.14L19,12.14L8,5.14Z" Margin="1,0,0,0" />
              <!-- Pause Icon -->
              <PathIcon Width="13" Height="13" Foreground="{StaticResource MusesPageBrush}" IsVisible="{Binding IsPlaying}"
                        Data="M14,19H18V5H14M6,19H10V5H6V19Z" />
            </Panel>
          </Button>

          <!-- Next -->
          <Button Classes="chrome" ToolTip.Tip="Next" AutomationProperties.Name="Next Track" Command="{Binding NextCommand}">
            <PathIcon Data="M16,18H18V6H16M6,18L14.5,12L6,6V18Z" />
          </Button>

          <!-- Repeat (Cycles Off -> All -> One) -->
          <Button Classes="chrome" Classes.active="{Binding RepeatOn}"
                  ToolTip.Tip="Repeat Mode" AutomationProperties.Name="Repeat Mode" Command="{Binding CycleRepeatCommand}">
            <Panel>
              <!-- Repeat One Icon -->
              <PathIcon Data="M13,15V9H12L10,10V11H11.5V15H13M17,17H7V14L3,18L7,22V19H19V13H17M7,7H17V10L21,6L17,2V5H5V11H7V7Z"
                        IsVisible="{Binding IsRepeatOne}" />
              <!-- Repeat Normal Icon -->
              <PathIcon Data="M17,17H7V14L3,18L7,22V19H19V13H17M7,7H17V10L21,6L17,2V5H5V11H7V7Z"
                        IsVisible="{Binding !IsRepeatOne}" />
            </Panel>
          </Button>
        </StackPanel>

        <!-- 2. Centered Identity Area -->
        <Button Grid.Column="1"
                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Command="{Binding ToggleNowPlayingCommand}"
                ToolTip.Tip="Open Now Playing"
                AutomationProperties.Name="Open Now Playing">
          <Panel>
            <!-- Not Playing State -->
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !HasTrack}">
              <ctrl:MusesMark MarkSize="28" />
              <TextBlock Text="{Binding NotPlayingLabel}"
                         FontSize="13" FontWeight="Medium"
                         Foreground="{StaticResource MusesTextSecondaryBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>

            <!-- Playing Identity State -->
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasTrack}">
              <!-- Artwork (40x40 rounded 6) -->
              <Border Width="40" Height="40" CornerRadius="6" ClipToBounds="True"
                      BoxShadow="0 2 6 0 #40000000">
                <ctrl:ArtworkControl Width="40" Height="40" CornerRadius="6" GlyphSize="16"
                                     SourceUrl="{Binding NowPlayingArtworkUrl}" />
              </Border>
              <!-- Title & Artist -->
              <StackPanel VerticalAlignment="Center" Spacing="1" MaxWidth="190">
                <TextBlock Text="{Binding NowPlayingTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{Binding NowPlayingArtist}" FontSize="11" Foreground="{StaticResource MusesTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
              </StackPanel>
              <!-- Position / Duration Readout -->
              <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MusesTextSecondaryBrush}" FontFamily="Consolas, monospace" Margin="4,0,0,0">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0}  /  {1}">
                    <Binding Path="CurrentPositionFormatted" />
                    <Binding Path="CurrentDurationFormatted" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </Panel>
        </Button>

        <!-- 3. Trailing Controls Cluster -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <!-- Lyrics Drawer Toggle -->
          <Button Classes="chrome" Classes.active="{Binding IsLyricsDrawerOpen}"
                  ToolTip.Tip="Lyrics" AutomationProperties.Name="Lyrics Drawer" Command="{Binding ToggleLyricsDrawerCommand}">
            <PathIcon Data="M9,22A1,1 0 0,1 8,21V18H4A2,2 0 0,1 2,16V4C2,2.89 2.9,2 4,2H20A2,2 0 0,1 22,4V16A2,2 0 0,1 20,18H13.9L10.2,21.71C10,21.9 9.75,22 9.5,22H9Z" />
          </Button>

          <!-- Queue Drawer Toggle -->
          <Button Classes="chrome" Classes.active="{Binding IsQueueDrawerOpen}"
                  ToolTip.Tip="Queue" AutomationProperties.Name="Queue Drawer" Command="{Binding ToggleQueueDrawerCommand}">
            <PathIcon Data="M3,13H15V11H3M3,6V8H21V6M3,18H9V16H3V18Z" />
          </Button>

          <!-- Volume Flyout Button -->
          <Button Classes="chrome" ToolTip.Tip="Volume" AutomationProperties.Name="Volume">
            <Button.Flyout>
              <Flyout Placement="Top" ShowMode="Transient">
                <Flyout.FlyoutPresenterTheme>
                  <ControlTheme TargetType="FlyoutPresenter">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                  </ControlTheme>
                </Flyout.FlyoutPresenterTheme>
                <ctrl:VolumeSliderControl />
              </Flyout>
            </Button.Flyout>
            <Panel>
              <!-- Speaker Muted -->
              <PathIcon Data="M12,4L9.91,6.09L12,8.18M4.27,3L3,4.27L7.73,9H3V15H7L12,20V13.27L16.25,17.53C15.58,18.04 14.83,18.46 14,18.7V20.77C15.38,20.45 16.63,19.82 17.68,18.96L19.73,21L21,19.73L4.27,3M19,12C19,12.82 18.85,13.61 18.59,14.34L20.2,15.95C20.71,14.77 21,13.43 21,12A9,9 0 0,0 12,3V5.08C15.92,5.55 19,8.42 19,12M12,4L9.91,6.09L12,8.18M16.5,12C16.5,10.23 15.5,8.71 14,7.97V10.18L16.45,12.63C16.5,12.43 16.5,12.21 16.5,12Z"
                        IsVisible="{Binding CurrentVolume, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}" />
              <!-- Speaker Low -->
              <PathIcon Data="M5,9V15H9L14,20V4L9,9H5Z"
                        IsVisible="{Binding CurrentVolume, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=0}" />
            </Panel>
          </Button>

          <!-- Watch YouTube Video -->
          <Button Classes="chrome" ToolTip.Tip="Watch YouTube Video" AutomationProperties.Name="Watch YouTube Video" Command="{Binding ToggleVideoOverlayCommand}"
                  IsEnabled="{Binding HasNowPlayingYouTubeId}"
                  IsVisible="{Binding HasNowPlayingYouTubeId}">
            <ctrl:YouTubeMark MarkSize="16" />
          </Button>
        </StackPanel>
      </Grid>
    </Panel>
  </Border>
</UserControl>
