<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Muses.App.ViewModels"
             xmlns:ctrl="using:Muses.App.Controls"
             x:Class="Muses.App.Views.HomeView"
             x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="ctrl|AlbumCardControl.browseOnly ctrl|HoverPlayButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.homeAction">
      <Setter Property="Background" Value="{DynamicResource MusesSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MusesTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MusesHairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,24,32,36" Spacing="28" MaxWidth="1560">

      <StackPanel Spacing="6">
        <TextBlock Text="{Binding HomeLabel}"
                   FontSize="38" FontFamily="{StaticResource MusesHeadingFont}"
                   Foreground="{DynamicResource MusesHeadingBrush}" />
        <Button x:Name="HomeSourceButton" Classes="homeAction" HorizontalAlignment="Left">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{Binding HomeMusesSourceLabel}" Click="OnSelectMusesHome" />
              <MenuItem Header="{Binding HomeYouTubeSourceLabel}" Click="OnSelectAccountHome"
                        IsEnabled="{Binding CanSelectAccountHome}" />
              <Separator />
              <MenuItem Header="{Binding RetryLabel}" Click="OnRetryAccountHome"
                        IsVisible="{Binding IsAccountHomeSelected}" IsEnabled="{Binding WebHomeEnabled}" />
              <MenuItem Header="{Binding HomeAccountSettingsLabel}" Click="OnOpenHomeAccountSettings" />
            </MenuFlyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="HomeSourceLabel" FontSize="13" />
            <PathIcon Width="10" Height="10" Data="M2,4 L6,8 L10,4" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="HomeSourceStatus" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource MusesTextSecondaryBrush}" />
      </StackPanel>

      <StackPanel x:Name="LoadingAccountHome" IsVisible="False" Spacing="8">
        <TextBlock Text="{Binding HomeAccountLoadingLabel}" FontSize="13"
                   Foreground="{DynamicResource MusesTextSecondaryBrush}" />
        <ProgressBar IsIndeterminate="True" Width="100" Height="3" HorizontalAlignment="Left" />
      </StackPanel>

      <Border x:Name="EmptyAccountHome" Background="{DynamicResource MusesSurfaceBrush}"
              CornerRadius="14" Padding="18,16" BorderBrush="{DynamicResource MusesHairlineBrush}"
              BorderThickness="1" IsVisible="False">
        <StackPanel Spacing="8">
          <TextBlock x:Name="EmptyAccountHomeTitle" FontWeight="SemiBold" FontSize="15"
                     Foreground="{DynamicResource MusesTextPrimaryBrush}" />
          <TextBlock x:Name="EmptyAccountHomeBody" FontSize="13" TextWrapping="Wrap"
                     Foreground="{DynamicResource MusesTextSecondaryBrush}" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Classes="homeAction" Content="{Binding HomeAccountSettingsLabel}" Click="OnOpenHomeAccountSettings" />
            <Button x:Name="RetryAccountHome" Classes="homeAction" Content="{Binding RetryLabel}" Click="OnRetryAccountHome" />
            <Button Classes="homeAction" Content="{Binding HomeMusesSourceLabel}" Click="OnSelectMusesHome" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border x:Name="EmptyHome" Background="{DynamicResource MusesSurfaceBrush}"
              CornerRadius="14" Padding="18,16" BorderBrush="{DynamicResource MusesHairlineBrush}"
              BorderThickness="1" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock x:Name="EmptyHomeTitle" FontWeight="SemiBold" FontSize="15"
                       Foreground="{DynamicResource MusesTextPrimaryBrush}" />
            <TextBlock x:Name="EmptyHomeBody" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource MusesTextSecondaryBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Content="{Binding SearchLabel}"
                  Background="{DynamicResource MusesPlaybackBrush}" Foreground="{DynamicResource MusesOnPlaybackBrush}"
                  CornerRadius="16" Padding="18,8" VerticalAlignment="Center"
                  Command="{Binding OpenSearchWindowCommand}" />
        </Grid>
      </Border>

      <!-- Top Picks (Portrait Cards) -->
      <StackPanel x:Name="TopPicksSection" Spacing="13">
        <TextBlock Text="{Binding TopPicksLabel}"
                   FontSize="24" FontFamily="{StaticResource MusesHeadingFont}"
                   Foreground="{DynamicResource MusesHeadingBrush}" />
        <Panel>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TopPicksContainer" Orientation="Horizontal" Spacing="18" Margin="0,0,56,0" />
          </ScrollViewer>
          <Border Width="56" HorizontalAlignment="Right" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Offset="0" Color="#001F1F1F" />
                <GradientStop Offset="1" Color="{DynamicResource MusesPageColor}" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Panel>
      </StackPanel>

      <!-- Discovery Shelves Container -->
      <StackPanel x:Name="ShelvesContainer" Spacing="34" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
