<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Muses.App.ViewModels"
             xmlns:lyr="using:Muses.Core.Lyrics"
             x:Class="Muses.App.Views.LyricsDrawerView"
             x:DataType="vm:ShellViewModel"
             Width="360" Background="{DynamicResource MusesGlassDrawerBrush}">
  <UserControl.Styles>
    <Style Selector="Button.closeBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.lyricLine">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.lyricLine:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource MusesWhiteOverlay0ABrush}" />
    </Style>
    <Style Selector="Button.offsetBtn">
      <Setter Property="Background" Value="{StaticResource MusesWhiteOverlay14Brush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Styles>

  <Border BorderBrush="{StaticResource MusesHairlineBrush}" BorderThickness="1,0,0,0">
    <DockPanel Margin="20,24,20,96">
      <!-- Header -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <StackPanel Spacing="2">
          <TextBlock Text="Lyrics" FontSize="20" FontWeight="Bold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
          <TextBlock Text="{Binding NowPlayingTitle}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}"
                     MaxWidth="260" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1" Classes="closeBtn" Command="{Binding CloseLyricsDrawerCommand}" ToolTip.Tip="Close">
          <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                    Width="16" Height="16" Foreground="{StaticResource MusesTextSecondaryBrush}" />
        </Button>
      </Grid>

      <!-- Offset Fine-Tuner -->
      <Border DockPanel.Dock="Bottom" Background="{StaticResource MusesWhiteOverlay14Brush}" CornerRadius="8" Padding="10,6" Margin="0,12,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <TextBlock Text="Offset" FontSize="11" Foreground="{StaticResource MusesTextSecondaryBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" x:Name="OffsetLabel" Text="0.0s" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource MusesTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="offsetBtn" Content="-0.5s" Click="OnMinusOffset" Margin="0,0,4,0" />
          <Button Grid.Column="3" Classes="offsetBtn" Content="+0.5s" Click="OnPlusOffset" />
        </Grid>
      </Border>

      <!-- Lyrics Viewport -->
      <Panel>
        <!-- Loading State -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                    IsVisible="{Binding Lyrics.IsLoading, FallbackValue=False}">
          <ProgressBar IsIndeterminate="True" Width="24" Height="24" />
          <TextBlock Text="Loading lyrics..." FontSize="13" Foreground="{StaticResource MusesTextSecondaryBrush}" />
        </StackPanel>

        <!-- Empty State -->
        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="No lyrics available" FontSize="14" Foreground="{StaticResource MusesWhiteOverlay66Brush}"
                   IsVisible="{Binding !Lyrics.HasLyrics, FallbackValue=True}" />

        <!-- Synced / Plain Lyrics List -->
        <ScrollViewer x:Name="LyricsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="LyricsLinesContainer" Spacing="4" />
        </ScrollViewer>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
