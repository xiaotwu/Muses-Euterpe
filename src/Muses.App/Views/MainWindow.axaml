<wnd:AppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:wnd="using:FluentAvalonia.UI.Windowing"
               xmlns:views="using:Muses.App.Views"
               xmlns:vm="using:Muses.App.ViewModels"
               x:Class="Muses.App.Views.MainWindow"
               x:DataType="vm:ShellViewModel"
               Title="Muses"
               Width="1280" Height="800"
               MinWidth="840" MinHeight="600"
               TransparencyLevelHint="Mica,AcrylicBlur,Transparent"
               Background="Transparent"
               ExtendClientAreaToDecorationsHint="True"
               ExtendClientAreaChromeHints="PreferSystemChrome"
               ExtendClientAreaTitleBarHeightHint="32"
               KeyDown="OnKeyDown">
  <views:RootView />
</wnd:AppWindow>
