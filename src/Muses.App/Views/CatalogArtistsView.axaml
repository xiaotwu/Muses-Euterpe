<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Muses.App.ViewModels"
             xmlns:ctrl="using:Muses.App.Controls"
             x:Class="Muses.App.Views.CatalogArtistsView"
             x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="Button.artistCard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.artistCard /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.artistCard ctrl|HoverPlayButton">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{StaticResource MusesMotionHover}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.artistCard:pointerover ctrl|HoverPlayButton">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,32,40,96" Spacing="28" MaxWidth="1560">

      <!-- Header -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding ArtistsLabel}"
                     FontSize="34" FontWeight="Heavy"
                     Foreground="{StaticResource MusesTextPrimaryBrush}" />
          <TextBlock x:Name="CountLabel" Text="0 artists"
                     FontSize="13" Foreground="{StaticResource MusesTextSecondaryBrush}" />
        </StackPanel>

        <!-- Refresh Button -->
        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0"
                Cursor="Hand" ToolTip.Tip="Refresh Catalog" Click="OnRefreshClicked" VerticalAlignment="Center">
          <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                    Width="14" Height="14" Foreground="{StaticResource MusesTextSecondaryBrush}" />
        </Button>
      </Grid>

      <!-- Artists Grid -->
      <WrapPanel x:Name="ArtistsWrapPanel" Orientation="Horizontal" Margin="-10,0" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
