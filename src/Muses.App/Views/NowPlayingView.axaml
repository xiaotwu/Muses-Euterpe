<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Muses.App.ViewModels"
             xmlns:ctrl="using:Muses.App.Controls"
             xmlns:playback="using:Muses.App.Controls.Playback"
             x:Class="Muses.App.Views.NowPlayingView"
             x:DataType="vm:ShellViewModel"
             Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle"
             Background="{DynamicResource MusesPageBrush}"
             ClipToBounds="True">
  <UserControl.Styles>
    <Style Selector="Button.chromeBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chromeBtn PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource MusesTextMutedBrush}" />
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
    </Style>
    <Style Selector="Button.chromeBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MusesHairlineBrush}" />
    </Style>
    <Style Selector="Button.chromeBtn:pointerover PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource MusesTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.chromeCapsuleBtn">
      <Setter Property="Background" Value="{DynamicResource MusesSurfaceOverlay1FBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MusesHairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chromeCapsuleBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MusesWhiteOverlay2ABrush}" />
    </Style>
    <Style Selector="Button.stageCircleBtn">
      <Setter Property="Background" Value="{DynamicResource MusesHairlineBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MusesWhiteOverlay14Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.stageCircleBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MusesWhiteOverlay33Brush}" />
    </Style>
    <Style Selector="Button.stageCircleBtn PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource MusesTextMutedBrush}" />
    </Style>
    <Style Selector="Button.stageCircleBtn.liked PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource MusesAccentBrush}" />
    </Style>
    <Style Selector="Button.transportBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.transportBtn PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource MusesTextMutedBrush}" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Button.transportBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MusesWhiteOverlay14Brush}" />
    </Style>
    <Style Selector="Button.transportBtn:pointerover PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource MusesTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.transportBtn.active PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource MusesAccentBrush}" />
    </Style>
    <Style Selector="Button.nowPlayingLine">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.nowPlayingLine:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MusesWhiteOverlay0DBrush}" />
    </Style>
    <Style Selector="Button.dockPlayBtn:pointerover /template/ ContentPresenter, Button.dockPlayBtn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
    </Style>
    <Style Selector="TextBlock.lyricLine">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MusesTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.lyricLine.active">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource MusesAccentBrush}" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <Panel Opacity="{DynamicResource MusesGlassAtmosphereOpacity}" IsHitTestVisible="False">
      <ctrl:ArtworkControl SourceUrl="{Binding NowPlayingArtworkUrl}" Margin="-48" Opacity="0.30">
        <ctrl:ArtworkControl.Effect>
          <BlurEffect Radius="56" />
        </ctrl:ArtworkControl.Effect>
      </ctrl:ArtworkControl>
      <Border Background="{DynamicResource MusesPageBrush}" Opacity="0.66" />
    </Panel>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="24,16,24,24">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="chromeCapsuleBtn" Command="{Binding CloseNowPlayingCommand}"
                ToolTip.Tip="{playback:PlaybackText 'Close Now Playing', 关闭正在播放}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                      Width="14" Height="14" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
            <TextBlock Text="{playback:PlaybackText Back, 返回}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource MusesTextPrimaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <!-- Audio Info / Audio Nerd -->
          <Button Classes="chromeBtn" Command="{Binding ToggleAudioNerdCommand}" ToolTip.Tip="{playback:PlaybackText 'Audio Info (Nerd Mode)', 音频信息}" AutomationProperties.Name="{playback:PlaybackText 'Audio Info (Nerd Mode)', 音频信息}">
            <PathIcon Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" />
          </Button>

          <!-- Equalizer -->
          <Button Classes="chromeBtn" Command="{Binding ToggleEQCommand}" ToolTip.Tip="{playback:PlaybackText 'Equalizer', 均衡器}" AutomationProperties.Name="{playback:PlaybackText 'Equalizer', 均衡器}">
            <PathIcon Data="M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M17,9V7H21V5H17V3H15V9H17Z" />
          </Button>

          <!-- Focus Mode -->
          <Button Classes="chromeBtn" Command="{Binding ToggleFocusCommand}" ToolTip.Tip="{playback:PlaybackText 'Focus Mode', 专注模式}" AutomationProperties.Name="{playback:PlaybackText 'Focus Mode', 专注模式}">
            <PathIcon Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z" />
          </Button>

          <!-- Notes & Bookmarks -->
          <Button Classes="chromeBtn" Command="{Binding ToggleNotesCommand}" ToolTip.Tip="{playback:PlaybackText 'Track Notes &amp; Bookmarks', 曲目笔记与书签}" AutomationProperties.Name="{playback:PlaybackText 'Track Notes &amp; Bookmarks', 曲目笔记与书签}">
            <PathIcon Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M17,17H7V15H17V17M17,13H7V11H17V13M17,9H7V7H17V9Z" />
          </Button>
          <Button Classes="chromeBtn" Command="{Binding ToggleNowPlayingModeCommand}"
                  ToolTip.Tip="{playback:PlaybackText 'Switch cover / vinyl', 切换封面或唱片}"
                  AutomationProperties.Name="{playback:PlaybackText 'Switch cover / vinyl', 切换封面或唱片}">
            <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z" />
          </Button>
          <Button Classes="chromeBtn" Command="{Binding ToggleNowPlayingLyricsModeCommand}"
                  ToolTip.Tip="{playback:PlaybackText 'Fullscreen lyrics', 全屏歌词}"
                  AutomationProperties.Name="{playback:PlaybackText 'Fullscreen lyrics', 全屏歌词}">
            <PathIcon Data="M3,3H9V5H5V9H3V3M15,3H21V9H19V5H15V3M3,15H5V19H9V21H3V15M19,15H21V21H15V19H19V15Z" />
          </Button>
          <Button Classes="chromeBtn" Command="{Binding ToggleVideoOverlayCommand}"
                  IsVisible="{Binding HasNowPlayingYouTubeId}"
                  ToolTip.Tip="{playback:PlaybackText 'Watch YouTube video', 观看 YouTube 视频}"
                  AutomationProperties.Name="{playback:PlaybackText 'Watch YouTube video', 观看 YouTube 视频}">
            <ctrl:YouTubeMark MarkSize="16" />
          </Button>
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" x:Name="StageScroll" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Disabled">
        <Grid x:Name="StageGrid" ColumnDefinitions="Auto,*" RowDefinitions="*" MaxWidth="1520">
          <StackPanel x:Name="ArtworkStage" VerticalAlignment="Center"
                      HorizontalAlignment="Center" Spacing="22">
            <Panel x:Name="ArtworkSlot" HorizontalAlignment="Center">
              <Border x:Name="CoverArtBorder" Width="320" Height="320" CornerRadius="12"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      BoxShadow="0 12 35 0 #65000000">
                <ctrl:ArtworkControl SourceUrl="{Binding NowPlayingArtworkUrl}" GlyphSize="64" CornerRadius="12" />
              </Border>
              <Border x:Name="VinylContainer" Width="320" Height="320" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      BoxShadow="0 12 35 0 #65000000">
                <playback:VinylArtworkControl x:Name="VinylArtwork"
                                              SourceUrl="{Binding NowPlayingArtworkUrl}" GlyphSize="64" />
              </Border>
            </Panel>
            <!-- Track Identity (Title, Subtitle, Like & More) -->
            <Grid ColumnDefinitions="*,Auto" Margin="0" MinHeight="48">
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding NowPlayingTitle}"
                           FontSize="20" FontWeight="Bold" FontFamily="{DynamicResource MusesHeadingFont}" Foreground="{DynamicResource MusesTextPrimaryBrush}"
                           TextWrapping="Wrap" MaxLines="2" />
                <TextBlock Text="{Binding NowPlayingSubtitle, FallbackValue=''}"
                           FontSize="14" Foreground="{DynamicResource MusesTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Like Button -->
                <Button Classes="stageCircleBtn" Classes.liked="{Binding IsCurrentTrackLiked}"
                        Command="{Binding ToggleCurrentTrackLikeCommand}" ToolTip.Tip="{playback:PlaybackText 'Favorite / Like', 收藏}" AutomationProperties.Name="{playback:PlaybackText 'Favorite / Like', 收藏}">
                  <PathIcon Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"
                            Width="13" Height="13" />
                </Button>

                <!-- More Button with Menu -->
                <Button Classes="stageCircleBtn" ToolTip.Tip="{playback:PlaybackText 'More Actions', 更多操作}" AutomationProperties.Name="{playback:PlaybackText 'More Actions', 更多操作}">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="{Binding SaveTrackLabel}" Command="{Binding SaveCurrentTrackCommand}"
                                IsVisible="{Binding CanSaveCurrentTrack}" />
                      <MenuItem Header="{playback:PlaybackText 'Play Next', 接下来播放}" Command="{Binding PlayNextCurrentTrackCommand}">
                        <MenuItem.Icon>
                          <PathIcon Data="M16,18H18V6H16M6,18L14.5,12L6,6V18Z" Width="12" Height="12" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{playback:PlaybackText 'Add to Queue', 添加到队列}" Command="{Binding AddCurrentTrackToQueueCommand}">
                        <MenuItem.Icon>
                          <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="{playback:PlaybackText 'Open on YouTube', 在 YouTube 打开}" Command="{Binding OpenCurrentTrackOnYouTubeCommand}">
                        <MenuItem.Icon>
                          <ctrl:YouTubeMark MarkSize="12" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{playback:PlaybackText 'Add to Inbox', 添加到收件箱}" Command="{Binding AddCurrentTrackToInboxCommand}">
                        <MenuItem.Icon>
                          <PathIcon Data="M19,15H15A3,3 0 0,1 12,18A3,3 0 0,1 9,15H5V5H19M19,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3Z" Width="12" Height="12" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="{playback:PlaybackText 'Track Notes &amp; Bookmarks', 曲目笔记与书签}" Command="{Binding ToggleNotesCommand}">
                        <MenuItem.Icon>
                          <PathIcon Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M17,17H7V15H17V17M17,13H7V11H17V13M17,9H7V7H17V9Z" Width="12" Height="12" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Flyout>
                  <PathIcon Data="M16,12A2,2 0 0,1 18,10A2,2 0 0,1 20,12A2,2 0 0,1 18,14A2,2 0 0,1 16,12M10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12M4,12A2,2 0 0,1 6,10A2,2 0 0,1 8,12A2,2 0 0,1 6,14A2,2 0 0,1 4,12Z"
                            Width="13" Height="13" Foreground="{DynamicResource MusesTextMutedBrush}" />
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>

          <!-- Right Stage: Synced Lyrics View & Bookmarks -->
          <Border Grid.Column="1" x:Name="LyricsColumn">
            <DockPanel>
              <!-- Bookmark jump chips (Final Spec §10.7) -->
              <Border DockPanel.Dock="Top" Margin="0,0,0,12" IsVisible="{Binding HasBookmarks}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding CurrentTrackBookmarks}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Background="{DynamicResource MusesSurfaceBrush}" Foreground="{DynamicResource MusesAccentBrush}" BorderBrush="{DynamicResource MusesHairlineBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="8,4" Cursor="Hand"
                                Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).SeekToBookmarkCommand}"
                                CommandParameter="{Binding TimestampMs}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🔖" FontSize="10" />
                            <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>

              <TextBlock x:Name="LyricsPlaceholder" DockPanel.Dock="Top"
                         Text="{playback:PlaybackText 'Lyrics are unavailable for this track', 此曲目暂无歌词}"
                         Margin="10,20" Foreground="{DynamicResource MusesTextSecondaryBrush}"
                         FontSize="16" TextWrapping="Wrap" />
              <ScrollViewer x:Name="LyricsScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LyricsPanel" Spacing="10" VerticalAlignment="Center" Margin="0,20,10,20" />
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="2" x:Name="PlaybackDock" HorizontalAlignment="Center" MaxWidth="668"
              CornerRadius="28" Padding="18,10" Background="{DynamicResource MusesGlassClearBrush}"
              BorderBrush="{DynamicResource MusesGlassRimBrush}" BorderThickness="1"
              BoxShadow="{DynamicResource MusesGlassPlaybackShadow}" IsVisible="{Binding HasTrack}">
        <StackPanel Spacing="3">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
            <TextBlock x:Name="ElapsedLabel" Text="0:00" FontSize="11" FontFamily="monospace"
                       Foreground="{DynamicResource MusesTextSecondaryBrush}" VerticalAlignment="Center" />
            <Panel Grid.Column="1">
              <Slider x:Name="ProgressSlider" Minimum="0" SmallChange="5" LargeChange="15"
                      IsVisible="{Binding PlaybackStatusText, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                      AutomationProperties.Name="{playback:PlaybackText 'Playback position', 播放进度}" />
              <TextBlock Text="{Binding PlaybackStatusText}" IsVisible="{Binding IsPlaybackLoading}"
                         Foreground="{DynamicResource MusesTextSecondaryBrush}" FontSize="12"
                         VerticalAlignment="Center" HorizontalAlignment="Center"
                         TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasPlaybackError}">
                <TextBlock Text="{Binding PlaybackStatusText}" Foreground="{DynamicResource MusesTextPrimaryBrush}"
                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="1" Classes="chromeCapsuleBtn" Command="{Binding TogglePlaybackCommand}"
                        Content="{playback:PlaybackText Retry, 重试}" />
              </Grid>
            </Panel>
            <TextBlock Grid.Column="2" x:Name="RemainingLabel" Text="−0:00" FontSize="11" FontFamily="monospace"
                       Foreground="{DynamicResource MusesTextSecondaryBrush}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <ToggleButton x:Name="InlineLyricsButton" IsChecked="False" Click="ToggleInlineLyrics"
                          Width="32" Height="32" Padding="0" CornerRadius="16"
                          Background="Transparent" BorderThickness="0" Cursor="Hand"
                          VerticalAlignment="Center"
                          ToolTip.Tip="{playback:PlaybackText Lyrics, 歌词}"
                          AutomationProperties.Name="{playback:PlaybackText Lyrics, 歌词}">
              <PathIcon Data="M9,22A1,1 0 0,1 8,21V18H4A2,2 0 0,1 2,16V4C2,2.89 2.9,2 4,2H20A2,2 0 0,1 22,4V16A2,2 0 0,1 20,18H13.9L10.2,21.71C10,21.9 9.75,22 9.5,22H9Z"
                        Width="14" Height="14" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
            </ToggleButton>
            <!-- Transport Control Bar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
              <!-- Shuffle -->
              <Button Classes="transportBtn" Classes.active="{Binding ShuffleOn}"
                      Command="{Binding ToggleShuffleCommand}" ToolTip.Tip="{playback:PlaybackText 'Shuffle', 随机播放}" AutomationProperties.Name="{playback:PlaybackText 'Shuffle', 随机播放}">
                <PathIcon Data="M14.83,13.41L13.42,14.82L16.55,17.95L14.5,20H20V14.5L17.96,16.54L14.83,13.41M14.5,4L16.54,6.04L4,18.59L5.41,20L17.96,7.46L20,9.5V4M10.59,9.17L5.41,4L4,5.41L9.17,10.58L10.59,9.17Z" />
              </Button>

              <!-- Previous -->
              <Button Classes="transportBtn" Command="{Binding PreviousCommand}" ToolTip.Tip="{playback:PlaybackText 'Previous', 上一首}" AutomationProperties.Name="{playback:PlaybackText 'Previous', 上一首}">
                <PathIcon Data="M6,18V6H8V18H6M9.5,12L18,6V18L9.5,12Z" Width="20" Height="20" />
              </Button>

              <!-- Big White Circle Play/Pause Button -->
              <Border Width="38" Height="38" CornerRadius="19"
                      BoxShadow="0 6 18 0 #40000000">
                <Button Width="38" Height="38" CornerRadius="19"
                        Classes="dockPlayBtn" Background="#F5EFE6" BorderThickness="0" Padding="0"
                        Cursor="Hand" ToolTip.Tip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}"
                        Command="{Binding TogglePlaybackCommand}">
                  <Panel>
                    <PathIcon Width="18" Height="18" Foreground="#30291E" IsVisible="{Binding !IsPlaying}"
                              Data="M8,5.14V19.14L19,12.14L8,5.14Z" Margin="2,0,0,0" />
                    <PathIcon Width="18" Height="18" Foreground="#30291E" IsVisible="{Binding IsPlaying}"
                              Data="M14,19H18V5H14M6,19H10V5H6V19Z" />
                  </Panel>
                </Button>
              </Border>

              <!-- Next -->
              <Button Classes="transportBtn" Command="{Binding NextCommand}" ToolTip.Tip="{playback:PlaybackText 'Next', 下一首}" AutomationProperties.Name="{playback:PlaybackText 'Next', 下一首}">
                <PathIcon Data="M16,18H18V6H16M6,18L14.5,12L6,6V18Z" Width="20" Height="20" />
              </Button>

              <!-- Repeat -->
              <Button Classes="transportBtn" Classes.active="{Binding RepeatOn}"
                      Command="{Binding CycleRepeatCommand}" ToolTip.Tip="{playback:PlaybackText 'Repeat', 循环播放}" AutomationProperties.Name="{playback:PlaybackText 'Repeat', 循环播放}">
                <Panel>
                  <PathIcon Data="M17,17H7V14L3,18L7,22V19H19V13H17M7,7H17V10L21,6L17,2V5H5V11H7V7Z"
                            IsVisible="{Binding !IsRepeatOne}" />
                  <PathIcon Data="M13,15V9H12L10,10V11H11.5V15H13M17,17H7V14L3,18L7,22V19H19V13H17M7,7H17V10L21,6L17,2V5H5V11H7V7Z"
                            IsVisible="{Binding IsRepeatOne}" />
                </Panel>
              </Button>
            </StackPanel>
            <Button Grid.Column="2" Classes="chromeBtn" VerticalAlignment="Center"
                    ToolTip.Tip="{playback:PlaybackText Volume, 音量}"
                    AutomationProperties.Name="{playback:PlaybackText Volume, 音量}">
              <Button.Flyout>
                <Flyout Placement="Top" ShowMode="Transient">
                  <ctrl:VolumeSliderControl Width="170" Height="32" />
                </Flyout>
              </Button.Flyout>
              <PathIcon Data="M5,9V15H9L14,20V4L9,9H5ZM16,7C18,8 19,10 19,12C19,14 18,16 16,17V15C17,14 17.5,13 17.5,12C17.5,11 17,10 16,9V7Z" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Panel>
</UserControl>
