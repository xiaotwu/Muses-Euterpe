<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Muses.App.ViewModels"
             xmlns:ctrl="using:Muses.App.Controls"
             xmlns:np="using:Muses.Core.NowPlaying"
             x:Class="Muses.App.Views.NowPlayingView"
             x:DataType="vm:ShellViewModel"
             Background="{StaticResource MusesPageBrush}">
  <UserControl.Styles>
    <Style Selector="Button.chromeBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chromeBtn PathIcon">
      <Setter Property="Foreground" Value="{StaticResource MusesTextMutedBrush}" />
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
    </Style>
    <Style Selector="Button.chromeBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource MusesHairlineBrush}" />
    </Style>
    <Style Selector="Button.chromeBtn:pointerover PathIcon">
      <Setter Property="Foreground" Value="{StaticResource MusesTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.chromeCapsuleBtn">
      <Setter Property="Background" Value="{StaticResource MusesSurfaceOverlay1FBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MusesHairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chromeCapsuleBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource MusesWhiteOverlay2ABrush}" />
    </Style>
    <Style Selector="Button.stageCircleBtn">
      <Setter Property="Background" Value="{StaticResource MusesHairlineBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource MusesWhiteOverlay14Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.stageCircleBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource MusesWhiteOverlay33Brush}" />
    </Style>
    <Style Selector="Button.stageCircleBtn PathIcon">
      <Setter Property="Foreground" Value="{StaticResource MusesTextMutedBrush}" />
    </Style>
    <Style Selector="Button.stageCircleBtn.liked PathIcon">
      <Setter Property="Foreground" Value="{StaticResource MusesAccentBrush}" />
    </Style>
    <Style Selector="Button.transportBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.transportBtn PathIcon">
      <Setter Property="Foreground" Value="{StaticResource MusesTextMutedBrush}" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Button.transportBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource MusesWhiteOverlay14Brush}" />
    </Style>
    <Style Selector="Button.transportBtn:pointerover PathIcon">
      <Setter Property="Foreground" Value="{StaticResource MusesTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.transportBtn.active PathIcon">
      <Setter Property="Foreground" Value="{StaticResource MusesAccentBrush}" />
    </Style>
    <Style Selector="Button.nowPlayingLine">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.nowPlayingLine:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource MusesWhiteOverlay0DBrush}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- Ambient Backdrop Artwork Blur Glow -->
    <ctrl:ArtworkControl SourceUrl="{Binding NowPlayingArtworkUrl}"
                         Opacity="0.18" Margin="-100" />
    <Border Background="{StaticResource MusesPageOpaqueDarkBrush}" />

    <DockPanel Margin="48,28,48,36">
      <!-- Top Chrome Bar -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
        <!-- Close / Dismiss Button -->
        <Button Classes="chromeCapsuleBtn" Command="{Binding CloseNowPlayingCommand}" ToolTip.Tip="Close Now Playing (Esc)">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                      Width="13" Height="13" Foreground="{StaticResource MusesTextPrimaryBrush}" />
            <TextBlock Text="Back" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Trailing: Utility buttons + Volume Bar -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- Audio Info / Audio Nerd -->
          <Button Classes="chromeBtn" Command="{Binding ToggleAudioNerdCommand}" ToolTip.Tip="Audio Info (Nerd Mode)">
            <PathIcon Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" />
          </Button>

          <!-- Equalizer -->
          <Button Classes="chromeBtn" Command="{Binding ToggleEQCommand}" ToolTip.Tip="Equalizer">
            <PathIcon Data="M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M17,9V7H21V5H17V3H15V9H17Z" />
          </Button>

          <!-- Focus Mode -->
          <Button Classes="chromeBtn" Command="{Binding ToggleFocusCommand}" ToolTip.Tip="Focus Mode">
            <PathIcon Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z" />
          </Button>

          <!-- Notes & Bookmarks -->
          <Button Classes="chromeBtn" Command="{Binding ToggleNotesCommand}" ToolTip.Tip="Track Notes &amp; Bookmarks">
            <PathIcon Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M17,17H7V15H17V17M17,13H7V11H17V13M17,9H7V7H17V9Z" />
          </Button>

          <!-- Add to Inbox -->
          <Button Classes="chromeBtn" Command="{Binding AddCurrentTrackToInboxCommand}" ToolTip.Tip="Add to Inbox">
            <PathIcon Data="M19,15H15A3,3 0 0,1 12,18A3,3 0 0,1 9,15H5V5H19M19,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3Z" />
          </Button>

          <!-- Volume Bar -->
          <Border Margin="6,0,0,0">
            <ctrl:VolumeSliderControl Width="180" Height="32" />
          </Border>
        </StackPanel>
      </Grid>

      <!-- Main Stage Grid (Split Left Stage / Right Lyrics) -->
      <Grid x:Name="StageGrid" ColumnDefinitions="*,*">

        <!-- Left Stage: Artwork, Scrubber & Controls -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,0,24,0">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" Width="400">

            <!-- Artwork Container: Cover Art or Vinyl -->
            <Panel HorizontalAlignment="Center" Margin="0,4">

              <!-- COVER ART MODE -->
              <Border x:Name="CoverArtBorder" Width="360" Height="360" CornerRadius="16" ClipToBounds="True"
                      BoxShadow="0 20 40 0 #80000000">
                <ctrl:ArtworkControl SourceUrl="{Binding NowPlayingArtworkUrl}" GlyphSize="80" />
              </Border>

              <!-- VINYL MODE -->
              <Grid x:Name="VinylContainer" Width="400" Height="280" IsVisible="False">
                <!-- Vinyl Disc (Emerging from right of jacket) -->
                <Border x:Name="VinylDisc" Width="260" Height="260" CornerRadius="130"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#111111" BorderBrush="#222222" BorderThickness="2"
                        BoxShadow="0 10 30 0 #80000000" ClipToBounds="True">
                  <Panel>
                    <!-- Vinyl Grooves Rings -->
                    <Ellipse Width="220" Height="220" Stroke="{StaticResource MusesWhiteOverlay26Brush}" StrokeThickness="1" />
                    <Ellipse Width="180" Height="180" Stroke="{StaticResource MusesHairlineBrush}" StrokeThickness="1" />
                    <Ellipse Width="140" Height="140" Stroke="{StaticResource MusesHairlineBrush}" StrokeThickness="1" />

                    <!-- Center Label Artwork -->
                    <Border Width="96" Height="96" CornerRadius="48" ClipToBounds="True"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                      <ctrl:ArtworkControl SourceUrl="{Binding NowPlayingArtworkUrl}" GlyphSize="28" />
                    </Border>
                    <!-- Center Hole -->
                    <Ellipse Width="12" Height="12" Fill="#000000"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                </Border>

                <!-- Album Sleeve Jacket (Left) -->
                <Border Width="260" Height="260" CornerRadius="10" ClipToBounds="True"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        BoxShadow="0 14 36 0 #99000000">
                  <ctrl:ArtworkControl SourceUrl="{Binding NowPlayingArtworkUrl}" GlyphSize="64" />
                </Border>
              </Grid>

            </Panel>

            <!-- Track Identity (Title, Subtitle, Like & More) -->
            <Grid ColumnDefinitions="*,Auto" Margin="4,4,4,0" MinHeight="48">
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding NowPlayingTitle, FallbackValue='Not Playing'}"
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource MusesTextPrimaryBrush}"
                           TextWrapping="Wrap" MaxLines="2" />
                <TextBlock Text="{Binding NowPlayingSubtitle, FallbackValue=''}"
                           FontSize="14" Foreground="{StaticResource MusesTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Like Button -->
                <Button Classes="stageCircleBtn" Classes.liked="{Binding IsCurrentTrackLiked}"
                        Command="{Binding ToggleCurrentTrackLikeCommand}" ToolTip.Tip="Favorite / Like">
                  <PathIcon Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"
                            Width="13" Height="13" />
                </Button>

                <!-- More Button with Menu -->
                <Button Classes="stageCircleBtn" ToolTip.Tip="More Actions">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Play Next" Command="{Binding PlayNextCurrentTrackCommand}">
                        <MenuItem.Icon>
                          <PathIcon Data="M16,18H18V6H16M6,18L14.5,12L6,6V18Z" Width="12" Height="12" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Add to Queue" Command="{Binding AddCurrentTrackToQueueCommand}">
                        <MenuItem.Icon>
                          <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="Open on YouTube" Command="{Binding OpenCurrentTrackOnYouTubeCommand}">
                        <MenuItem.Icon>
                          <ctrl:YouTubeMark MarkSize="12" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Add to Inbox" Command="{Binding AddCurrentTrackToInboxCommand}">
                        <MenuItem.Icon>
                          <PathIcon Data="M19,15H15A3,3 0 0,1 12,18A3,3 0 0,1 9,15H5V5H19M19,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3Z" Width="12" Height="12" />
                        </MenuItem.Icon>
                      </MenuItem>
                      <MenuItem Header="Track Notes &amp; Bookmarks" Command="{Binding ToggleNotesCommand}">
                        <MenuItem.Icon>
                          <PathIcon Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M17,17H7V15H17V17M17,13H7V11H17V13M17,9H7V7H17V9Z" Width="12" Height="12" />
                        </MenuItem.Icon>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Flyout>
                  <PathIcon Data="M16,12A2,2 0 0,1 18,10A2,2 0 0,1 20,12A2,2 0 0,1 18,14A2,2 0 0,1 16,12M10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12M4,12A2,2 0 0,1 6,10A2,2 0 0,1 8,12A2,2 0 0,1 6,14A2,2 0 0,1 4,12Z"
                            Width="13" Height="13" Foreground="{StaticResource MusesTextMutedBrush}" />
                </Button>
              </StackPanel>
            </Grid>

            <!-- Scrubber Slider & Timing -->
            <StackPanel Spacing="4" Margin="0,4,0,0">
              <Slider x:Name="ProgressSlider" Minimum="0"
                      Maximum="{Binding CurrentDurationSeconds, FallbackValue=100}"
                      Value="{Binding CurrentPositionSeconds, Mode=OneWay}"
                      PointerCaptureLost="OnSliderPointerCaptureLost" />
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock x:Name="ElapsedLabel" Text="0:00" FontSize="11" Foreground="{StaticResource MusesWhiteOverlay99Brush}" FontFamily="Consolas, monospace" />
                <TextBlock Grid.Column="1" Text="{Binding QualityLabel}" FontSize="10" Foreground="{StaticResource MusesWhiteOverlay66Brush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" x:Name="RemainingLabel" Text="-0:00" FontSize="11"
                           Foreground="{StaticResource MusesWhiteOverlay99Brush}" FontFamily="Consolas, monospace" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>

            <!-- Transport Control Bar -->
            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
              <!-- Shuffle -->
              <Button Classes="transportBtn" Classes.active="{Binding ShuffleOn}"
                      Command="{Binding ToggleShuffleCommand}" ToolTip.Tip="Shuffle">
                <PathIcon Data="M14.83,13.41L13.42,14.82L16.55,17.95L14.5,20H20V14.5L17.96,16.54L14.83,13.41M14.5,4L16.54,6.04L4,18.59L5.41,20L17.96,7.46L20,9.5V4M10.59,9.17L5.41,4L4,5.41L9.17,10.58L10.59,9.17Z" />
              </Button>

              <!-- Previous -->
              <Button Classes="transportBtn" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous">
                <PathIcon Data="M6,18V6H8V18H6M9.5,12L18,6V18L9.5,12Z" Width="20" Height="20" />
              </Button>

              <!-- Big White Circle Play/Pause Button -->
              <Border Width="48" Height="48" CornerRadius="24"
                      BoxShadow="0 6 18 0 #40000000">
                <Button Width="48" Height="48" CornerRadius="24"
                        Background="{StaticResource MusesTextPrimaryBrush}" BorderThickness="0"
                        Cursor="Hand" ToolTip.Tip="{Binding PlayLabel}"
                        Command="{Binding TogglePlaybackCommand}">
                  <Panel>
                    <PathIcon Width="18" Height="18" Foreground="{StaticResource MusesPageBrush}" IsVisible="{Binding !IsPlaying}"
                              Data="M8,5.14V19.14L19,12.14L8,5.14Z" Margin="2,0,0,0" />
                    <PathIcon Width="18" Height="18" Foreground="{StaticResource MusesPageBrush}" IsVisible="{Binding IsPlaying}"
                              Data="M14,19H18V5H14M6,19H10V5H6V19Z" />
                  </Panel>
                </Button>
              </Border>

              <!-- Next -->
              <Button Classes="transportBtn" Command="{Binding NextCommand}" ToolTip.Tip="Next">
                <PathIcon Data="M16,18H18V6H16M6,18L14.5,12L6,6V18Z" Width="20" Height="20" />
              </Button>

              <!-- Repeat -->
              <Button Classes="transportBtn" Classes.active="{Binding RepeatOn}"
                      Command="{Binding CycleRepeatCommand}" ToolTip.Tip="Repeat">
                <PathIcon Data="M17,17H7V14L3,18L7,22V19H19V13H17M7,7H17V10L21,6L17,2V5H5V11H7V7Z" />
              </Button>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- Right Stage: Synced Lyrics View & Bookmarks -->
        <Border Grid.Column="1" x:Name="LyricsColumn" Margin="24,0,0,0">
          <DockPanel>
            <!-- Bookmark jump chips (Final Spec §10.7) -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12" IsVisible="{Binding HasBookmarks}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding CurrentTrackBookmarks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Background="{StaticResource MusesSurfaceBrush}" Foreground="{StaticResource MusesAccentBrush}" BorderBrush="{StaticResource MusesHairlineBrush}" BorderThickness="1"
                              CornerRadius="6" Padding="8,4" Cursor="Hand"
                              Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).SeekToBookmarkCommand}"
                              CommandParameter="{Binding TimestampMs}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="🔖" FontSize="10" />
                          <TextBlock Text="{Binding Title, FallbackValue='Bookmark'}" FontSize="11" Foreground="{StaticResource MusesTextPrimaryBrush}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>

            <ScrollViewer x:Name="LyricsScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="LyricsPanel" Spacing="10" VerticalAlignment="Center" Margin="0,40,0,40" />
            </ScrollViewer>
          </DockPanel>
        </Border>

      </Grid>
    </DockPanel>

    <!-- Floating Bottom-Right Controls (Vinyl Mode & Lyrics Mode) -->
    <StackPanel Orientation="Horizontal" Spacing="10"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,48,32">
      <!-- Switch Cover / Vinyl Mode -->
      <Button Classes="stageCircleBtn" Width="32" Height="32" CornerRadius="16"
              Command="{Binding ToggleNowPlayingModeCommand}"
              ToolTip.Tip="Toggle Vinyl / Cover Mode">
        <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"
                  Width="14" Height="14" Foreground="{StaticResource MusesWhiteOverlayD1Brush}" />
      </Button>

      <!-- Toggle Lyrics Mode -->
      <Button Classes="stageCircleBtn" Width="32" Height="32" CornerRadius="16"
              Command="{Binding ToggleNowPlayingLyricsModeCommand}"
              ToolTip.Tip="Toggle Lyrics Mode">
        <PathIcon Data="M9,22A1,1 0 0,1 8,21V18H4A2,2 0 0,1 2,16V4C2,2.89 2.9,2 4,2H20A2,2 0 0,1 22,4V16A2,2 0 0,1 20,18H13.9L10.2,21.71C10,21.9 9.75,22 9.5,22H9Z"
                  Width="14" Height="14" Foreground="{StaticResource MusesWhiteOverlayD1Brush}" />
      </Button>
    </StackPanel>
  </Panel>
</UserControl>
