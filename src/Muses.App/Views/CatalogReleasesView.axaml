<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Muses.App.ViewModels"
             xmlns:ctrl="using:Muses.App.Controls"
             xmlns:cat="using:Muses.Core.Catalog"
             x:Class="Muses.App.Views.CatalogReleasesView"
             x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="Button.filterChip">
      <Setter Property="Background" Value="{StaticResource MusesHairlineBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.filterChip.selected">
      <Setter Property="Background" Value="{StaticResource MusesAccentBrush}" />
    </Style>
    <Style Selector="Button.filterChip TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MusesTextPrimaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.filterChip.selected TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.releaseCard">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.releaseCard /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.releaseCard ctrl|HoverPlayButton">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{StaticResource MusesMotionHover}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.releaseCard:pointerover ctrl|HoverPlayButton">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,32,40,96" Spacing="28" MaxWidth="1560">

      <!-- Header & Controls -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding AlbumsLabel}"
                     FontSize="34" FontWeight="Heavy"
                     Foreground="{StaticResource MusesTextPrimaryBrush}" />
          <TextBlock x:Name="CountLabel" Text="0 releases"
                     FontSize="13" Foreground="{StaticResource MusesTextSecondaryBrush}" />
        </StackPanel>

        <!-- Filters, Sort, and Refresh -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <!-- Filter Chips -->
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="FilterAllBtn" Classes="filterChip selected" Click="OnFilterAll">
              <TextBlock Text="All" />
            </Button>
            <Button x:Name="FilterAlbumsBtn" Classes="filterChip" Click="OnFilterAlbums">
              <TextBlock Text="Albums" />
            </Button>
            <Button x:Name="FilterSinglesBtn" Classes="filterChip" Click="OnFilterSingles">
              <TextBlock Text="Singles &amp; EPs" />
            </Button>
          </StackPanel>

          <!-- Sort Selection -->
          <ComboBox x:Name="SortCombo" SelectedIndex="0" SelectionChanged="OnSortChanged"
                    Background="{StaticResource MusesHairlineBrush}" BorderThickness="0" CornerRadius="8" Padding="10,6">
            <ComboBoxItem Content="By Title" />
            <ComboBoxItem Content="By Artist" />
            <ComboBoxItem Content="By Year" />
          </ComboBox>

          <!-- Refresh Button -->
          <Button Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0"
                  Cursor="Hand" ToolTip.Tip="Refresh Catalog" Click="OnRefreshClicked">
            <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                      Width="14" Height="14" Foreground="{StaticResource MusesTextSecondaryBrush}" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Releases Grid -->
      <WrapPanel x:Name="ReleasesWrapPanel" Orientation="Horizontal" Margin="-10,0" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
