<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Muses.App.ViewModels"
             xmlns:ctrl="using:Muses.App.Controls"
             x:Class="Muses.App.Views.SettingsView"
             x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="Button.categoryBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.categoryBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource MusesWhiteOverlay14Brush}" />
    </Style>
    <Style Selector="Button.categoryBtn.selected">
      <Setter Property="Background" Value="{StaticResource MusesAccentBrush}" />
    </Style>
    <Style Selector="Button.categoryBtn.selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource MusesAccentBrush}" />
    </Style>
    <Style Selector="Button.categoryBtn TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MusesTextPrimaryBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.categoryBtn.selected TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.actionBtn">
      <Setter Property="Background" Value="{StaticResource MusesHairlineBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.actionBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource MusesWhiteOverlay2EBrush}" />
    </Style>
    <Style Selector="Button.actionBtn TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MusesTextPrimaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primaryActionBtn">
      <Setter Property="Background" Value="{StaticResource MusesAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primaryActionBtn TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="180,*">
    <!-- Left Category Navigation -->
    <Border Background="{StaticResource MusesHairlineBrush}" CornerRadius="12,0,0,12" Padding="12,20">
      <StackPanel Spacing="4">
        <Button x:Name="CatGeneralBtn" Classes="categoryBtn selected" Click="OnSelectGeneral">
          <TextBlock Text="{Binding SettingsCatGeneral}" />
        </Button>
        <Button x:Name="CatPlaybackBtn" Classes="categoryBtn" Click="OnSelectPlayback">
          <TextBlock Text="{Binding SettingsCatPlayback}" />
        </Button>
        <Button x:Name="CatQualityBtn" Classes="categoryBtn" Click="OnSelectQuality">
          <TextBlock Text="{Binding SettingsCatQuality}" />
        </Button>
        <Button x:Name="CatAppearanceBtn" Classes="categoryBtn" Click="OnSelectAppearance">
          <TextBlock Text="{Binding SettingsCatAppearance}" />
        </Button>
        <Button x:Name="CatYouTubeBtn" Classes="categoryBtn" Click="OnSelectYouTube">
          <TextBlock Text="{Binding SettingsCatYouTube}" />
        </Button>
        <Button x:Name="CatLyricsBtn" Classes="categoryBtn" Click="OnSelectLyrics">
          <TextBlock Text="{Binding SettingsCatLyrics}" />
        </Button>
        <Button x:Name="CatDesktopBtn" Classes="categoryBtn" Click="OnSelectDesktop">
          <TextBlock Text="{Binding SettingsCatDesktop}" />
        </Button>
        <Button x:Name="CatAboutBtn" Classes="categoryBtn" Click="OnSelectAbout">
          <TextBlock Text="{Binding SettingsCatAbout}" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Right Detail Page -->
    <Border Grid.Column="1" Padding="28,20" Background="{StaticResource MusesSurfaceBrush}" CornerRadius="0,12,12,0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Panel>

          <!-- 1. GENERAL -->
          <StackPanel x:Name="PageGeneral" Spacing="20">
            <TextBlock Text="{Binding SettingsGeneralTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding SettingsLanguageLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
              <ComboBox SelectedIndex="{Binding LanguageSelectedIndex}" Width="200" Background="{StaticResource MusesWhiteOverlay14Brush}" BorderThickness="0" CornerRadius="6">
                <ComboBoxItem Content="System" />
                <ComboBoxItem Content="English" />
                <ComboBoxItem Content="简体中文" />
              </ComboBox>
            </StackPanel>
            <CheckBox Content="{Binding SettingsCloseToTrayLabel}" IsChecked="{Binding CloseToTray}" Foreground="{StaticResource MusesTextPrimaryBrush}" />
            <CheckBox Content="{Binding SettingsTrayLabel}" IsChecked="{Binding TrayEnabled}" Foreground="{StaticResource MusesTextPrimaryBrush}" />
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding SettingsClearCacheLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
              <TextBlock Text="{Binding SettingsClearCacheBody}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
              <Button Classes="actionBtn" Command="{Binding ClearCacheCommand}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding SettingsClearCacheLabel}" />
              </Button>
              <TextBlock Text="{Binding SettingsResetDataLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding SettingsResetDataBody}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
              <Button Classes="actionBtn" Command="{Binding ResetDataCommand}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding SettingsResetDataConfirmLabel}" />
              </Button>
              <TextBlock Text="{Binding SettingsCacheStatus}" FontSize="12" Foreground="{StaticResource MusesAccentBrush}"
                         IsVisible="{Binding SettingsCacheStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>

          <!-- 2. PLAYBACK -->
          <StackPanel x:Name="PagePlayback" Spacing="20" IsVisible="False">
            <TextBlock Text="{Binding SettingsPlaybackTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
            <CheckBox Content="{Binding SettingsResumeAfterVideoLabel}" IsChecked="{Binding ResumeAfterVideo}" Foreground="{StaticResource MusesTextPrimaryBrush}" />
            <CheckBox Content="{Binding SettingsReplayGainLabel}" IsChecked="{Binding ReplayGainEnabled}" Foreground="{StaticResource MusesTextPrimaryBrush}" />
            <TextBlock Text="{Binding SettingsReplayGainUnavailableNote}" FontSize="11" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding SettingsCrossfadeLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
              <Slider Minimum="0" Maximum="8" SmallChange="0.5" LargeChange="1" TickFrequency="0.5"
                      IsSnapToTickEnabled="True" Value="{Binding CrossfadeSeconds}" Width="280" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding CrossfadeLabel}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" />
              <TextBlock Text="{Binding SettingsCrossfadeBody}" FontSize="11" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>

          <!-- 3. QUALITY -->
          <StackPanel x:Name="PageQuality" Spacing="20" IsVisible="False">
            <TextBlock Text="{Binding SettingsAudioQualityTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding SettingsPreferredStreamLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
              <ComboBox SelectedIndex="{Binding AudioQualitySelectedIndex}" Width="240" Background="{StaticResource MusesWhiteOverlay14Brush}" BorderThickness="0" CornerRadius="6">
                <ComboBoxItem Content="{Binding SettingsQualityBestLabel}" />
                <ComboBoxItem Content="{Binding SettingsQualityHighLabel}" />
                <ComboBoxItem Content="{Binding SettingsQualityMediumLabel}" />
              </ComboBox>
            </StackPanel>
            <Border Background="{StaticResource MusesWhiteOverlay14Brush}" CornerRadius="8" Padding="12">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SettingsEngineStatusTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
                <TextBlock Text="{Binding SettingsEngineStatusBody}" FontSize="11" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 4. APPEARANCE -->
          <StackPanel x:Name="PageAppearance" Spacing="20" IsVisible="False">
            <TextBlock Text="{Binding SettingsAppearanceTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding SettingsAccentLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource MusesAccentBrush}" BorderBrush="White" BorderThickness="2" />
                <TextBlock Text="{Binding SettingsAccentNameLabel}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding SettingsThemeLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
              <ComboBox SelectedIndex="{Binding ThemeSelectedIndex}" Width="200" Background="{StaticResource MusesWhiteOverlay14Brush}" BorderThickness="0" CornerRadius="6">
                <ComboBoxItem Content="{Binding SettingsThemeDarkLabel}" />
                <ComboBoxItem Content="{Binding SettingsThemeLightLabel}" />
                <ComboBoxItem Content="{Binding SettingsThemeSystemLabel}" />
              </ComboBox>
            </StackPanel>
            <TextBlock Text="{Binding SettingsReduceMotionNote}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- 5. YOUTUBE -->
          <StackPanel x:Name="PageYouTube" Spacing="20" IsVisible="False">
            <TextBlock Text="{Binding SettingsYouTubeTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
            <Border Background="{StaticResource MusesWhiteOverlay14Brush}" CornerRadius="10" Padding="16">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding SettingsGoogleSignInLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
                    <TextBlock Text="{Binding SettingsGoogleSignInBody}"
                               FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AccountDisplayName}" FontSize="12" Foreground="{StaticResource MusesAccentBrush}"
                               IsVisible="{Binding IsAccountSignedIn}" />
                    <TextBlock Text="{Binding AccountErrorMessage}" FontSize="12" Foreground="{StaticResource MusesAccentBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding IsAccountError}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="primaryActionBtn" Command="{Binding SignInWithGoogleCommand}"
                            IsVisible="{Binding !IsAccountSignedIn}" IsEnabled="{Binding !IsAccountSigningIn}">
                      <TextBlock Text="{Binding SignInLabel}" />
                    </Button>
                    <Button Classes="actionBtn" Command="{Binding SignOutYouTubeCommand}"
                            IsVisible="{Binding IsAccountSignedIn}">
                      <TextBlock Text="{Binding SignOutLabel}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding SettingsTokensPrivacyLabel}" FontSize="11" Foreground="{StaticResource MusesWhiteOverlay73Brush}" TextWrapping="Wrap" />

            <Border Background="{StaticResource MusesWhiteOverlay14Brush}" CornerRadius="10" Padding="16">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding SettingsWebHomeTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
                    <TextBlock Text="{Binding SettingsWebHomeBody}"
                               FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding WebHomeStatusText}" FontSize="12" Foreground="{StaticResource MusesAccentBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="8">
                    <Button Classes="primaryActionBtn" Command="{Binding ToggleWebHomeCommand}">
                      <TextBlock Text="{Binding SettingsToggleWebHomeLabel}" />
                    </Button>
                    <Button Classes="actionBtn" Command="{Binding ProbeWebHomeCommand}">
                      <TextBlock Text="{Binding SettingsProbeWebHomeLabel}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 6. LYRICS -->
          <StackPanel x:Name="PageLyrics" Spacing="20" IsVisible="False">
            <TextBlock Text="{Binding SettingsLyricsTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
            <TextBlock Text="{Binding SettingsLyricsProviderNote}" FontSize="13" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SettingsLyricsAutoScrollNote}" FontSize="13" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- 7. DESKTOP -->
          <StackPanel x:Name="PageDesktop" Spacing="20" IsVisible="False">
            <TextBlock Text="{Binding SettingsDesktopTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
            <Border Background="{StaticResource MusesWhiteOverlay14Brush}" CornerRadius="10" Padding="16">
              <StackPanel Spacing="10">
                <CheckBox Content="{Binding SettingsMiniPlayerLabel}" IsChecked="{Binding MiniPlayerEnabled}" Foreground="{StaticResource MusesTextPrimaryBrush}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding SettingsMiniPlayerBody}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="actionBtn" Click="OnOpenMiniPlayer"
                          IsEnabled="{Binding MiniPlayerEnabled}">
                    <TextBlock Text="{Binding SettingsOpenMiniPlayerLabel}" />
                  </Button>
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource MusesWhiteOverlay14Brush}" CornerRadius="10" Padding="16">
              <StackPanel Spacing="10">
                <CheckBox Content="{Binding SettingsDesktopLyricsLabel}" IsChecked="{Binding DesktopLyricsEnabled}" Foreground="{StaticResource MusesTextPrimaryBrush}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding SettingsDesktopLyricsBody}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="actionBtn" Click="OnOpenDesktopLyrics"
                          IsEnabled="{Binding DesktopLyricsEnabled}">
                    <TextBlock Text="{Binding SettingsToggleDesktopLyricsLabel}" />
                  </Button>
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Spacing="6">
              <TextBlock Text="{Binding SettingsInWindowShortcutsTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
              <TextBlock Text="{Binding SettingsShortcutSearch}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" />
              <TextBlock Text="{Binding SettingsShortcutPlay}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" />
              <TextBlock Text="{Binding SettingsShortcutNext}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" />
              <TextBlock Text="{Binding SettingsShortcutPrev}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" />
              <CheckBox Content="{Binding SettingsGlobalHotkeysLabel}" IsChecked="{Binding GlobalHotkeysEnabled}" Foreground="{StaticResource MusesTextPrimaryBrush}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding SettingsGlobalHotkeysBody}" FontSize="11" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>

          <!-- 8. ABOUT -->
          <StackPanel x:Name="PageAbout" Spacing="16" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <ctrl:MusesMark MarkSize="36" />
              <StackPanel>
                <TextBlock Text="Muses" FontSize="24" FontWeight="Heavy" Foreground="{StaticResource MusesTextPrimaryBrush}" />
                <TextBlock Text="{Binding SettingsAboutVersion}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding SettingsAboutTagline}"
                       FontSize="13" Foreground="{StaticResource MusesTextMutedBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SettingsAboutAuthor}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" />
            <TextBlock Text="{Binding SettingsAutomationNote}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />

            <!-- Software Update Card -->
            <Border Background="{StaticResource MusesWhiteOverlay14Brush}" CornerRadius="10" Padding="16">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding SettingsSoftwareUpdateTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
                    <TextBlock Text="{Binding SettingsSoftwareUpdateBody}" FontSize="12" Foreground="{StaticResource MusesTextSecondaryBrush}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="actionBtn" Command="{Binding CheckForUpdatesCommand}"
                          IsEnabled="{Binding !IsCheckingForUpdates}">
                    <TextBlock Text="{Binding SettingsCheckForUpdatesLabel}" />
                  </Button>
                </Grid>

                <TextBlock Text="{Binding UpdateStatusMessage}" FontSize="12" Foreground="{StaticResource MusesAccentBrush}"
                           IsVisible="{Binding UpdateStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Spacing="6" IsVisible="{Binding HasAvailableUpdate}">
                  <TextBlock Text="{Binding AvailableUpdateInfo.ReleaseTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" />
                  <Button Classes="primaryActionBtn" Command="{Binding DownloadUpdateCommand}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding SettingsDownloadUpdateLabel}" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <Button Classes="actionBtn" Click="OnOpenGitHub" HorizontalAlignment="Left">
              <TextBlock Text="{Binding SettingsViewOnGitHubLabel}" />
            </Button>
          </StackPanel>

        </Panel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
