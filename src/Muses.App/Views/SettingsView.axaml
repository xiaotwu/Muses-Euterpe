<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Muses.App.ViewModels"
             xmlns:ctrl="using:Muses.App.Controls"
             x:Class="Muses.App.Views.SettingsView"
             x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="Button.actionBtn">
      <Setter Property="Background" Value="{DynamicResource MusesHairlineBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.actionBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MusesWhiteOverlay2EBrush}" />
    </Style>
    <Style Selector="Button.actionBtn TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MusesTextPrimaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primaryActionBtn">
      <Setter Property="Background" Value="{DynamicResource MusesAccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primaryActionBtn TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MusesPageBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Panel>

      <!-- 1. GENERAL -->
      <StackPanel IsVisible="{Binding IsSettingsGeneral}" Spacing="20">
        <TextBlock Text="{Binding SettingsGeneralTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SettingsLanguageLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
          <ComboBox SelectedIndex="{Binding LanguageSelectedIndex}" Width="200" Background="{DynamicResource MusesWhiteOverlay14Brush}" BorderThickness="0" CornerRadius="6">
            <ComboBoxItem Content="System" />
            <ComboBoxItem Content="English" />
            <ComboBoxItem Content="简体中文" />
          </ComboBox>
        </StackPanel>
        <CheckBox Content="{Binding SettingsCloseToTrayLabel}" IsChecked="{Binding CloseToTray}" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <CheckBox Content="{Binding SettingsTrayLabel}" IsChecked="{Binding TrayEnabled}" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding SettingsImportMacLibraryLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
          <TextBlock Text="{Binding SettingsImportMacLibraryBody}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
          <Button Classes="actionBtn" Click="OnImportMacLibrary" IsEnabled="{Binding CanImportMacLibrary}" HorizontalAlignment="Left"
                  AutomationProperties.Name="{Binding SettingsChooseMacBackupLabel}" AutomationProperties.HelpText="{Binding SettingsImportMacLibraryBody}">
            <TextBlock Text="{Binding SettingsChooseMacBackupLabel}" />
          </Button>
          <TextBlock Text="{Binding MacLibraryImportStatus}" FontSize="12" Foreground="{DynamicResource MusesAccentBrush}"
                     TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                     IsVisible="{Binding MacLibraryImportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding SettingsDataFolderLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" Margin="0,8,0,0" />
          <SelectableTextBlock Text="{Binding SettingsDataFolderPath}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
          <Button Classes="actionBtn" Click="OnOpenDataFolder" HorizontalAlignment="Left">
            <TextBlock Text="{Binding SettingsOpenDataFolderLabel}" />
          </Button>
          <TextBlock x:Name="OpenDataFolderStatus" FontSize="12" Foreground="{DynamicResource MusesAccentBrush}"
                     TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsVisible="False" />
          <TextBlock Text="{Binding SettingsClearCacheLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" Margin="0,8,0,0" />
          <TextBlock Text="{Binding SettingsClearCacheBody}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
          <Button Classes="actionBtn" Command="{Binding ClearCacheCommand}" HorizontalAlignment="Left">
            <TextBlock Text="{Binding SettingsClearCacheLabel}" />
          </Button>
          <TextBlock Text="{Binding SettingsResetDataLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" Margin="0,8,0,0" />
          <TextBlock Text="{Binding SettingsResetDataBody}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
          <Button Classes="actionBtn" Command="{Binding ResetDataCommand}" IsEnabled="{Binding !IsMacLibraryImportBusy}" HorizontalAlignment="Left">
            <TextBlock Text="{Binding SettingsResetDataConfirmLabel}" />
          </Button>
          <TextBlock Text="{Binding SettingsCacheStatus}" FontSize="12" Foreground="{DynamicResource MusesAccentBrush}"
                     IsVisible="{Binding SettingsCacheStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </StackPanel>

      <!-- 2. PLAYBACK -->
      <StackPanel IsVisible="{Binding IsSettingsPlayback}" Spacing="20">
        <TextBlock Text="{Binding SettingsPlaybackTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <CheckBox Content="{Binding SettingsResumeAfterVideoLabel}" IsChecked="{Binding ResumeAfterVideo}" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <CheckBox Content="{Binding SettingsReplayGainLabel}" IsChecked="{Binding ReplayGainEnabled}" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <TextBlock Text="{Binding SettingsReplayGainUnavailableNote}" FontSize="11" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding SettingsCrossfadeLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
          <Slider Minimum="0" Maximum="8" SmallChange="0.5" LargeChange="1" TickFrequency="0.5"
                  IsSnapToTickEnabled="True" Value="{Binding CrossfadeSeconds}" Width="280" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding CrossfadeLabel}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
          <TextBlock Text="{Binding SettingsCrossfadeBody}" FontSize="11" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>

      <!-- 3. QUALITY -->
      <StackPanel IsVisible="{Binding IsSettingsQuality}" Spacing="20">
        <TextBlock Text="{Binding SettingsAudioQualityTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SettingsPreferredStreamLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
          <ComboBox SelectedIndex="{Binding AudioQualitySelectedIndex}" Width="240" Background="{DynamicResource MusesWhiteOverlay14Brush}" BorderThickness="0" CornerRadius="6">
            <ComboBoxItem Content="{Binding SettingsQualityBestLabel}" />
            <ComboBoxItem Content="{Binding SettingsQualityHighLabel}" />
            <ComboBoxItem Content="{Binding SettingsQualityMediumLabel}" />
          </ComboBox>
        </StackPanel>
        <Border Background="{DynamicResource MusesWhiteOverlay14Brush}" CornerRadius="8" Padding="12">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding SettingsEngineStatusTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
            <TextBlock Text="{Binding SettingsEngineStatusBody}" FontSize="11" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 4. APPEARANCE -->
      <StackPanel IsVisible="{Binding IsSettingsAppearance}" Spacing="20">
        <TextBlock Text="{Binding SettingsAppearanceTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SettingsAccentLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource MusesAccentBrush}" BorderBrush="White" BorderThickness="2" />
            <TextBlock Text="{Binding SettingsAccentNameLabel}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SettingsThemeLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
          <ComboBox SelectedIndex="{Binding ThemeSelectedIndex}" Width="200" Background="{DynamicResource MusesWhiteOverlay14Brush}" BorderThickness="0" CornerRadius="6">
            <ComboBoxItem Content="{Binding SettingsThemeDarkLabel}" />
            <ComboBoxItem Content="{Binding SettingsThemeLightLabel}" />
            <ComboBoxItem Content="{Binding SettingsThemeSystemLabel}" />
          </ComboBox>
        </StackPanel>
        <CheckBox IsVisible="{Binding IsLinuxDesktop}" Content="{Binding SettingsReduceMotionLabel}"
                  IsChecked="{Binding LinuxReduceMotion, Mode=TwoWay}" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <TextBlock IsVisible="{Binding !IsLinuxDesktop}" Text="{Binding SettingsReduceMotionNote}"
                   FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <!-- 5. YOUTUBE -->
      <StackPanel IsVisible="{Binding IsSettingsYouTube}" Spacing="20">
        <TextBlock Text="{Binding SettingsYouTubeTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <Border Background="{DynamicResource MusesWhiteOverlay14Brush}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding SettingsGoogleSignInLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
                <TextBlock Text="{Binding SettingsGoogleSignInBody}"
                           FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AccountDisplayName}" FontSize="12" Foreground="{DynamicResource MusesAccentBrush}"
                           IsVisible="{Binding IsAccountSignedIn}" />
                <TextBlock Text="{Binding AccountErrorMessage}" FontSize="12" Foreground="{DynamicResource MusesAccentBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsAccountError}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="primaryActionBtn" Command="{Binding SignInWithGoogleCommand}"
                        IsVisible="{Binding !IsAccountSignedIn}" IsEnabled="{Binding !IsAccountSigningIn}">
                  <TextBlock Text="{Binding SignInLabel}" />
                </Button>
                <Button Classes="actionBtn" Command="{Binding SignOutYouTubeCommand}"
                        IsVisible="{Binding IsAccountSignedIn}">
                  <TextBlock Text="{Binding SignOutLabel}" />
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding SettingsTokensPrivacyLabel}" FontSize="11" Foreground="{DynamicResource MusesWhiteOverlay73Brush}" TextWrapping="Wrap" />

        <Border Background="{DynamicResource MusesWhiteOverlay14Brush}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding SettingsWebHomeTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
            <TextBlock Text="{Binding SettingsWebHomeBody}"
                       FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding WebHomeStatusText}" FontSize="12" Foreground="{DynamicResource MusesAccentBrush}" TextWrapping="Wrap" />
            <Panel IsVisible="{Binding !WebHomeEnabled}" IsEnabled="{Binding CanSelectAccountHome}">
              <Button x:Name="ReviewWebHomeConsent" Classes="actionBtn" Click="OnReviewWebHomeConsent"
                      IsEnabled="{Binding IsAccountSignedIn}">
                <TextBlock Text="{Binding SettingsReviewWebHomeLabel}" />
              </Button>
            </Panel>
            <Border x:Name="WebHomeConsentPanel" IsVisible="False" Padding="12" CornerRadius="8"
                    Background="{DynamicResource MusesSurfaceBrush}" KeyDown="OnWebHomeConsentKeyDown">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding SettingsWebHomeConsentTitle}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SettingsWebHomeConsentBody}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource MusesTextSecondaryBrush}" />
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button x:Name="CancelWebHomeConsent" Classes="actionBtn" Click="OnCancelWebHomeConsent">
                    <TextBlock Text="{Binding CancelLabel}" />
                  </Button>
                  <Button Classes="primaryActionBtn" Click="OnConfirmWebHomeConsent">
                    <TextBlock Text="{Binding SettingsAllowWebHomeLabel}" />
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>
            <WrapPanel IsVisible="{Binding WebHomeEnabled}" ItemSpacing="8" LineSpacing="8">
              <Button x:Name="CheckWebHomeSession" Classes="actionBtn" Command="{Binding ProbeWebHomeCommand}"
                      IsEnabled="{Binding IsAccountSignedIn}">
                <TextBlock Text="{Binding SettingsProbeWebHomeLabel}" />
              </Button>
              <Button Classes="actionBtn" Command="{Binding DisableWebHomeCommand}">
                <TextBlock Text="{Binding SettingsDisableWebHomeLabel}" />
              </Button>
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 6. LYRICS -->
      <StackPanel IsVisible="{Binding IsSettingsLyrics}" Spacing="20">
        <TextBlock Text="{Binding SettingsLyricsTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <TextBlock Text="{Binding SettingsLyricsProviderNote}" FontSize="13" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SettingsLyricsAutoScrollNote}" FontSize="13" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <!-- 7. DESKTOP -->
      <StackPanel IsVisible="{Binding IsSettingsDesktop}" Spacing="20">
        <TextBlock Text="{Binding SettingsDesktopTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
        <Border Background="{DynamicResource MusesWhiteOverlay14Brush}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="10">
            <CheckBox Content="{Binding SettingsMiniPlayerLabel}" IsChecked="{Binding MiniPlayerEnabled}" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding SettingsMiniPlayerBody}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="actionBtn" Click="OnOpenMiniPlayer"
                      IsEnabled="{Binding MiniPlayerEnabled}">
                <TextBlock Text="{Binding SettingsOpenMiniPlayerLabel}" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource MusesWhiteOverlay14Brush}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="10">
            <CheckBox Content="{Binding SettingsDesktopLyricsLabel}" IsChecked="{Binding DesktopLyricsEnabled}" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding SettingsDesktopLyricsBody}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="actionBtn" Click="OnOpenDesktopLyrics"
                      IsEnabled="{Binding DesktopLyricsEnabled}">
                <TextBlock Text="{Binding SettingsToggleDesktopLyricsLabel}" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Spacing="6">
          <TextBlock Text="{Binding SettingsInWindowShortcutsTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
          <TextBlock Text="{Binding SettingsShortcutSearch}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
          <TextBlock Text="{Binding SettingsShortcutPlay}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
          <TextBlock Text="{Binding SettingsShortcutNext}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
          <TextBlock Text="{Binding SettingsShortcutPrev}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
          <CheckBox Content="{Binding SettingsGlobalHotkeysLabel}" IsChecked="{Binding GlobalHotkeysEnabled}" Foreground="{DynamicResource MusesTextPrimaryBrush}" Margin="0,8,0,0" />
          <TextBlock Text="{Binding SettingsGlobalHotkeysBody}" FontSize="11" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>

      <!-- 8. ABOUT -->
      <StackPanel IsVisible="{Binding IsSettingsAbout}" Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <ctrl:MusesMark MarkSize="36" />
          <StackPanel>
            <TextBlock Text="Muses" FontSize="24" FontWeight="Heavy" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
            <TextBlock Text="{Binding SettingsAboutVersion}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding SettingsAboutTagline}"
                   FontSize="13" Foreground="{DynamicResource MusesTextMutedBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SettingsAboutAuthor}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
        <TextBlock Text="{Binding SettingsAutomationNote}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" TextWrapping="Wrap" />

        <!-- Software Update Card -->
        <Border Background="{DynamicResource MusesWhiteOverlay14Brush}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding SettingsSoftwareUpdateTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
                <TextBlock Text="{Binding SettingsSoftwareUpdateBody}" FontSize="12" Foreground="{DynamicResource MusesTextSecondaryBrush}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="actionBtn" Command="{Binding CheckForUpdatesCommand}"
                      IsEnabled="{Binding !IsCheckingForUpdates}">
                <TextBlock Text="{Binding SettingsCheckForUpdatesLabel}" />
              </Button>
            </Grid>

            <TextBlock Text="{Binding UpdateStatusMessage}" FontSize="12" Foreground="{DynamicResource MusesAccentBrush}"
                       IsVisible="{Binding UpdateStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Spacing="6" IsVisible="{Binding HasAvailableUpdate}">
              <TextBlock Text="{Binding AvailableUpdateInfo.ReleaseTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MusesTextPrimaryBrush}" />
              <Button Classes="primaryActionBtn" Command="{Binding DownloadUpdateCommand}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding SettingsDownloadUpdateLabel}" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <Button Classes="actionBtn" Click="OnOpenGitHub" HorizontalAlignment="Left">
          <TextBlock Text="{Binding SettingsViewOnGitHubLabel}" />
        </Button>
      </StackPanel>

    </Panel>
  </ScrollViewer>
</UserControl>
