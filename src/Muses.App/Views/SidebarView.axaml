<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Muses.App.ViewModels"
             xmlns:pref="using:Muses.Core.Preferences"
             x:Class="Muses.App.Views.SidebarView"
             x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="Border.island">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Width" Value="56" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="Background" Value="{DynamicResource MusesGlassClearBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MusesGlassRimBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.expandable:pointerover">
      <Setter Property="Width" Value="218" />
    </Style>
    <Style Selector="Border.expandable:focus-within">
      <Setter Property="Width" Value="218" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Height" Value="44" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.nav.circle">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource MusesTextPrimaryBrush}" />
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MusesTextPrimaryBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TextBlock.navLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.expandable:pointerover TextBlock.navLabel">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.expandable:focus-within TextBlock.navLabel">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{DynamicResource MusesSelectionBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MusesSelectionBrush}" />
    </Style>
    <Style Selector="Button.nav.selected PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource MusesAccentBrush}" />
    </Style>
    <Style Selector="Button.nav.selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MusesAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                Background="{x:Null}" VerticalAlignment="Center">
    <StackPanel Margin="16,12,0,12" Spacing="16">
      <Border Classes="island">
        <StackPanel>
          <Button Classes="nav circle"
                  Command="{Binding NavigateBackCommand}"
                  ToolTip.Tip="{Binding BackLabel}" AutomationProperties.Name="{Binding BackLabel}">
            <PathIcon Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.42-1.41L7.83 13H20Z" />
          </Button>
          <Button Classes="nav circle"
                  Command="{Binding NavigateForwardCommand}"
                  IsVisible="{Binding CanNavigateForward}"
                  ToolTip.Tip="{Binding ForwardLabel}" AutomationProperties.Name="{Binding ForwardLabel}">
            <PathIcon Data="M4 11h12.17l-5.59-5.59L12 4l8 8-8 8-1.42-1.41L16.17 13H4Z" />
          </Button>
        </StackPanel>
      </Border>

      <Border Classes="island expandable" IsVisible="{Binding !SettingsOpen}">
        <StackPanel>
          <Button Classes="nav" Classes.selected="{Binding IsHome}"
                  Command="{Binding SelectCommand}"
                  CommandParameter="{x:Static pref:SidebarSection.Home}"
                  ToolTip.Tip="{Binding HomeLabel}" AutomationProperties.Name="{Binding HomeLabel}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" />
              <TextBlock Grid.Column="1" Text="{Binding HomeLabel}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsSearch}"
                  Command="{Binding OpenSearchWindowCommand}"
                  ToolTip.Tip="{Binding SearchLabel}" AutomationProperties.Name="{Binding SearchLabel}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" />
              <TextBlock Grid.Column="1" Text="{Binding SearchLabel}" Classes="navLabel" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>

      <Border Classes="island expandable" IsVisible="{Binding !SettingsOpen}">
        <StackPanel>
          <Button Classes="nav" Classes.selected="{Binding IsDiscover}"
                  Command="{Binding SelectCommand}"
                  CommandParameter="{x:Static pref:SidebarSection.Discover}"
                  ToolTip.Tip="{Binding NewNavigationLabel}" AutomationProperties.Name="{Binding NewNavigationLabel}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M3,3H10V10H3Z M14,3H21V10H14Z M3,14H10V21H3Z M14,14H21V21H14Z" />
              <TextBlock Grid.Column="1" Text="{Binding NewNavigationLabel}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsSongs}"
                  Command="{Binding SelectCommand}"
                  CommandParameter="{x:Static pref:SidebarSection.Songs}"
                  ToolTip.Tip="{Binding SongsLabel}" AutomationProperties.Name="{Binding SongsLabel}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M12,3V13.55C11.41,13.21 10.73,13 10,13C7.79,13 6,14.79 6,17C6,19.21 7.79,21 10,21C12.21,21 14,19.21 14,17V7H18V3H12Z" />
              <TextBlock Grid.Column="1" Text="{Binding SongsLabel}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsAlbums}"
                  Command="{Binding SelectCommand}"
                  CommandParameter="{x:Static pref:SidebarSection.Albums}"
                  ToolTip.Tip="{Binding AlbumsLabel}" AutomationProperties.Name="{Binding AlbumsLabel}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,7A5,5 0 1,1 12,17A5,5 0 1,1 12,7M12,10A2,2 0 1,0 12,14A2,2 0 1,0 12,10Z" />
              <TextBlock Grid.Column="1" Text="{Binding AlbumsLabel}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsArtists}"
                  Command="{Binding SelectCommand}"
                  CommandParameter="{x:Static pref:SidebarSection.Artists}"
                  ToolTip.Tip="{Binding ArtistsLabel}" AutomationProperties.Name="{Binding ArtistsLabel}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M16,4A4,4 0 1,1 16,12A4,4 0 1,1 16,4M16,14C20.42,14 24,15.79 24,18V20H8V18C8,15.79 11.58,14 16,14M6,4A4,4 0 1,1 6,12A4,4 0 1,1 6,4M6,14C7,14 8,14.1 8.7,14.3C7,15.3 6,16.5 6,18V20H0V18C0,15.79 2.69,14 6,14Z" />
              <TextBlock Grid.Column="1" Text="{Binding ArtistsLabel}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsPodcasts}"
                  Command="{Binding SelectCommand}"
                  CommandParameter="{x:Static pref:SidebarSection.Podcasts}"
                  ToolTip.Tip="{Binding PodcastsLabel}" AutomationProperties.Name="{Binding PodcastsLabel}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M12 2a8 8 0 0 0-5.5 13.8l1.4-1.4A6 6 0 1 1 16.1 14.4l1.4 1.4A8 8 0 0 0 12 2ZM12 6a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm0 10a2 2 0 0 0-2 2l.6 4h2.8l.6-4a2 2 0 0 0-2-2Z" />
              <TextBlock Grid.Column="1" Text="{Binding PodcastsLabel}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsRecently}"
                  Command="{Binding SelectCommand}"
                  CommandParameter="{x:Static pref:SidebarSection.Recently}"
                  ToolTip.Tip="{Binding RecentlyLabel}" AutomationProperties.Name="{Binding RecentlyLabel}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,13V7H12.5V12.2L17,14.9L16.2,16.2Z" />
              <TextBlock Grid.Column="1" Text="{Binding RecentlyLabel}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsHistory}"
                  Command="{Binding SelectCommand}"
                  CommandParameter="{x:Static pref:SidebarSection.History}"
                  ToolTip.Tip="{Binding HistoryLabel}" AutomationProperties.Name="{Binding HistoryLabel}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M13,3A9,9 0 0,0 4,12H1L5,16L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11,19 9,18.2 8,17L6.6,18.4C8.2,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3M12,8V13L16.3,15.5L17,14.3L13.5,12.2V8Z" />
              <TextBlock Grid.Column="1" Text="{Binding HistoryLabel}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsPlaylists}"
                  Command="{Binding SelectCommand}"
                  CommandParameter="{x:Static pref:SidebarSection.Playlists}"
                  ToolTip.Tip="{Binding PlaylistsLabel}" AutomationProperties.Name="{Binding PlaylistsLabel}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M15,6H3V8H15V6M15,10H3V12H15V10M3,16H11V14H3V16M17,6V14.18C16.69,14.07 16.35,14 16,14A3,3 0 0,0 13,17A3,3 0 0,0 16,20A3,3 0 0,0 19,17V8H22V6H17Z" />
              <TextBlock Grid.Column="1" Text="{Binding PlaylistsLabel}" Classes="navLabel" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>

      <Border Classes="island expandable" IsVisible="{Binding SettingsOpen}">
        <StackPanel>
          <Button Classes="nav" Classes.selected="{Binding IsSettingsGeneral}"
                  Command="{Binding SelectSettingsCategoryCommand}"
                  CommandParameter="{x:Static vm:SettingsCategory.General}"
                  ToolTip.Tip="{Binding SettingsCatGeneral}" AutomationProperties.Name="{Binding SettingsCatGeneral}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M3 5H21V7H3ZM3 11H21V13H3ZM3 17H21V19H3ZM7 3H9V9H7ZM15 9H17V15H15ZM7 15H9V21H7Z" />
              <TextBlock Grid.Column="1" Text="{Binding SettingsCatGeneral}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsSettingsPlayback}"
                  Command="{Binding SelectSettingsCategoryCommand}"
                  CommandParameter="{x:Static vm:SettingsCategory.Playback}"
                  ToolTip.Tip="{Binding SettingsCatPlayback}" AutomationProperties.Name="{Binding SettingsCatPlayback}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M8 5V19L19 12Z" />
              <TextBlock Grid.Column="1" Text="{Binding SettingsCatPlayback}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsSettingsQuality}"
                  Command="{Binding SelectSettingsCategoryCommand}"
                  CommandParameter="{x:Static vm:SettingsCategory.Quality}"
                  ToolTip.Tip="{Binding SettingsCatQuality}" AutomationProperties.Name="{Binding SettingsCatQuality}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M3 10H6V14H3ZM9 6H12V18H9ZM15 3H18V21H15ZM21 8H24V16H21Z" />
              <TextBlock Grid.Column="1" Text="{Binding SettingsCatQuality}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsSettingsAppearance}"
                  Command="{Binding SelectSettingsCategoryCommand}"
                  CommandParameter="{x:Static vm:SettingsCategory.Appearance}"
                  ToolTip.Tip="{Binding SettingsCatAppearance}" AutomationProperties.Name="{Binding SettingsCatAppearance}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M12 2A10 10 0 1 0 12 22A10 10 0 1 0 12 2ZM12 4A8 8 0 1 1 12 20Z" />
              <TextBlock Grid.Column="1" Text="{Binding SettingsCatAppearance}" Classes="navLabel" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>

      <Border Classes="island expandable" IsVisible="{Binding SettingsOpen}">
        <StackPanel>
          <Button Classes="nav" Classes.selected="{Binding IsSettingsYouTube}"
                  Command="{Binding SelectSettingsCategoryCommand}"
                  CommandParameter="{x:Static vm:SettingsCategory.YouTube}"
                  ToolTip.Tip="{Binding SettingsCatYouTube}" AutomationProperties.Name="{Binding SettingsCatYouTube}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M4 5H20Q22 5 22 7V17Q22 19 20 19H4Q2 19 2 17V7Q2 5 4 5ZM10 8V16L16 12Z" />
              <TextBlock Grid.Column="1" Text="{Binding SettingsCatYouTube}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsSettingsLyrics}"
                  Command="{Binding SelectSettingsCategoryCommand}"
                  CommandParameter="{x:Static vm:SettingsCategory.Lyrics}"
                  ToolTip.Tip="{Binding SettingsCatLyrics}" AutomationProperties.Name="{Binding SettingsCatLyrics}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M4 4H20V20H4ZM7 7V9H17V7ZM7 11V13H17V11ZM7 15V17H13V15Z" />
              <TextBlock Grid.Column="1" Text="{Binding SettingsCatLyrics}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsSettingsDesktop}"
                  Command="{Binding SelectSettingsCategoryCommand}"
                  CommandParameter="{x:Static vm:SettingsCategory.Desktop}"
                  ToolTip.Tip="{Binding SettingsCatDesktop}" AutomationProperties.Name="{Binding SettingsCatDesktop}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M2 4H22V17H13V20H17V22H7V20H11V17H2ZM4 6V15H20V6Z" />
              <TextBlock Grid.Column="1" Text="{Binding SettingsCatDesktop}" Classes="navLabel" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsSettingsAbout}"
                  Command="{Binding SelectSettingsCategoryCommand}"
                  CommandParameter="{x:Static vm:SettingsCategory.About}"
                  ToolTip.Tip="{Binding SettingsCatAbout}" AutomationProperties.Name="{Binding SettingsCatAbout}">
            <Grid ColumnDefinitions="44,*" ClipToBounds="True">
              <PathIcon Data="M12 2A10 10 0 1 0 12 22A10 10 0 1 0 12 2ZM11 6H13V8H11ZM11 10H13V18H11Z" />
              <TextBlock Grid.Column="1" Text="{Binding SettingsCatAbout}" Classes="navLabel" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>

      <Border Classes="island">
        <Panel>
          <Button Classes="nav circle"
                  Command="{Binding OpenSettingsCommand}"
                  IsVisible="{Binding !SettingsOpen}"
                  ToolTip.Tip="{Binding SettingsLabel}" AutomationProperties.Name="{Binding SettingsLabel}">
            <PathIcon Data="M19.4 13A7.8 7.8 0 0 0 19.5 12 7.8 7.8 0 0 0 19.4 11L21.5 9.4 19.5 6 17 7A8.8 8.8 0 0 0 15.3 6L15 3.3H11L10.6 6A8.8 8.8 0 0 0 9 7L6.5 6 4.5 9.4 6.6 11A7.8 7.8 0 0 0 6.5 12 7.8 7.8 0 0 0 6.6 13L4.5 14.6 6.5 18 9 17A8.8 8.8 0 0 0 10.6 18L11 20.7H15L15.3 18A8.8 8.8 0 0 0 17 17L19.5 18 21.5 14.6ZM13 15.2A3.2 3.2 0 1 1 13 8.8 3.2 3.2 0 1 1 13 15.2Z" />
          </Button>
          <Button Classes="nav circle"
                  Command="{Binding SelectCommand}"
                  CommandParameter="{x:Static pref:SidebarSection.Home}"
                  IsVisible="{Binding SettingsOpen}"
                  ToolTip.Tip="{Binding HomeLabel}" AutomationProperties.Name="{Binding HomeLabel}">
            <PathIcon Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" />
          </Button>
        </Panel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
