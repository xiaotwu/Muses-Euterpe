<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Muses.App.ViewModels"
             x:Class="Muses.App.Views.EQView"
             x:DataType="vm:ShellViewModel">
  <Border Background="{StaticResource MusesSurfaceChromeBrush}"
          BorderBrush="{StaticResource MusesHairlineBrush}"
          BorderThickness="1"
          CornerRadius="16"
          Padding="20"
          Width="640"
          MaxHeight="500"
          BoxShadow="0 16 40 0 #80000000">
    <DockPanel>
      <!-- Header -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
        <TextBlock Text="Equalizer" FontSize="20" FontWeight="Bold" Foreground="{StaticResource MusesTextPrimaryBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Reset"
                Background="{StaticResource MusesSurfaceBrush}" Foreground="{StaticResource MusesAccentBrush}" BorderBrush="{StaticResource MusesHairlineBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,6" Margin="0,0,8,0"
                Command="{Binding ResetEQCommand}" Cursor="Hand" />
        <Button Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0"
                Foreground="{StaticResource MusesTextSecondaryBrush}" Cursor="Hand"
                Command="{Binding CloseEQCommand}" />
      </Grid>

      <!-- Bottom Presets Bar -->
      <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,16,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Presets" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MusesTextPrimaryBrush}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="+ Save As"
                  Background="{StaticResource MusesSurfaceBrush}" Foreground="{StaticResource MusesAccentBrush}" BorderBrush="{StaticResource MusesHairlineBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="10,4" FontSize="12"
                  Command="{Binding OpenSaveEQPresetCommand}" Cursor="Hand" />
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Flat" Classes="presetChip" Command="{Binding SelectEQPresetCommand}" CommandParameter="Flat" />
            <Button Content="HiFi" Classes="presetChip" Command="{Binding SelectEQPresetCommand}" CommandParameter="HiFi" />
            <Button Content="Bass Boost" Classes="presetChip" Command="{Binding SelectEQPresetCommand}" CommandParameter="BassBoost" />
            <Button Content="Vocal" Classes="presetChip" Command="{Binding SelectEQPresetCommand}" CommandParameter="Vocal" />
            <Button Content="Electronic" Classes="presetChip" Command="{Binding SelectEQPresetCommand}" CommandParameter="Electronic" />

            <ItemsControl ItemsSource="{Binding CustomEQPresets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding Name}" Classes="presetChip"
                          Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).SelectEQPresetCommand}"
                          CommandParameter="{Binding Id}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </StackPanel>

      <!-- Center: Frequency Response Visualizer Curve & Sliders -->
      <DockPanel>
        <!-- Curve Visualizer -->
        <Border DockPanel.Dock="Top" Height="100" Background="{StaticResource MusesPageBrush}" CornerRadius="8" Margin="0,0,0,12" ClipToBounds="True">
          <Canvas x:Name="CurveCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Border>

        <!-- 32-band Vertical Sliders -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding EQBandViewModels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="28" Spacing="4" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding GainReadout}" FontSize="9" Foreground="{StaticResource MusesTextSecondaryBrush}"
                             HorizontalAlignment="Center" />
                  <Slider Minimum="-24" Maximum="24" Value="{Binding Gain, Mode=TwoWay}"
                          Orientation="Vertical" Height="110" HorizontalAlignment="Center"
                          Foreground="{StaticResource MusesAccentBrush}" />
                  <TextBlock Text="{Binding Label}" FontSize="8" Foreground="{StaticResource MusesWhiteOverlay73Brush}"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </DockPanel>
  </Border>
</UserControl>
